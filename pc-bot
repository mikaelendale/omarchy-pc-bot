def wifi_name():
    for line in run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).splitlines():
        name, _, kind = line.rpartition(":")
        if kind in ("802-11-wireless", "wifi"):
            return name.replace("\\:", ":")
    for line in run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).splitlines():
        name, _, kind = line.rpartition(":")
        if kind not in ("loopback", "bridge", "tun"):
            return name.replace("\\:", ":")
    return ""


def cpu_temp():
    best = None
    for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
        kind = read(f"{zone}/type")
        try:
            t = int(read(f"{zone}/temp", "0")) / 1000
        except ValueError:
            continue
        if kind in ("x86_pkg_temp", "TCPU", "cpu-thermal", "k10temp"):
            return t
        if 0 < t < 120:
            best = max(best or 0, t)
    return best


def memory():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        info[k] = int(v.split()[0]) * 1024 if v.split() else 0
    total = info.get("MemTotal", 0)
    used = total - info.get("MemAvailable", 0)
    return used, total


def last_assistant_text(transcript_path):
    """The last thing Claude said in a Claude Code transcript."""
    try:
        with open(transcript_path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 400_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") != "assistant":
            continue
        content = (d.get("message") or {}).get("content")
        if isinstance(content, list):
            texts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
            text = "\n".join(t for t in texts if t.strip())
            if text.strip():
                return text.strip()
    return ""


def shorten(text, n):
    text = re.sub(r"\s+", " ", text).strip()
    return text if len(text) <= n else text[: n - 1].rstrip() + "…"


