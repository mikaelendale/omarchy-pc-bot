def to_daemon(payload):
    """Hand an event to the running service; False if it isn't running."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(json.dumps(payload).encode()[:16_000], SOCKET)
        return True
    except OSError:
        return False


def cmd_send(args):
    important = "--important" in args
    text = " ".join(a for a in args if a != "--important").strip()
    if not text:
        print("Usage: pc-bot send [--important] TEXT", file=sys.stderr)
        return 2
    if to_daemon({"text": text, "important": important}):
        return 0
    cfg = load_config()
    if not cfg.get("token"):
        return 1
    Telegram(cfg["token"]).send(cfg["chat_id"], text, plain_entities=True)
    return 0


def cmd_claude(_args):
    """Claude Code hook (Stop / Notification). Never blocks Claude for long."""
    if os.environ.get("PC_BOT_CHAT"):
        return 0                       # Claude answering you on Telegram; the reply is the message
    try:
        hook = json.load(sys.stdin)
    except ValueError:
        return 0
    project = os.path.basename(hook.get("cwd") or "") or "a session"
    event = hook.get("hook_event_name")
    if event == "Stop":
        said = shorten(last_assistant_text(hook.get("transcript_path") or ""), 300)
        text = f"**Claude finished** in {md(project)}" + (f"\n\n> {md(said)}" if said else "")
        to_daemon({"text": text, "kind": f"claude-stop-{hook.get('session_id')}", "every": 20})
    elif event == "Notification":
        message = shorten(str(hook.get("message") or "Claude needs you"), 300)
        to_daemon({"text": f"**Claude needs you** in {md(project)}\n\n> {md(message)}",
                   "kind": f"claude-need-{hook.get('session_id')}", "every": 60})
    return 0


def cmd_unlock(_args):
