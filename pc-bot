def cmd_run(_args):
    if os.path.exists(CONFIG):
        try:
            with open(CONFIG) as f:
                json.load(f)
        except (OSError, ValueError) as e:
            # Fail loudly (systemd keeps retrying and it shows in the logs);
            # quietly exiting as "not set up" would just turn the alerts off.
            log(f"config unreadable ({e}); fix or restore {CONFIG}")
            return 1
    cfg = load_config()
    if not (cfg.get("token") and cfg.get("chat_id")):
        log("not set up yet: run `pc-bot setup`")
        return 0
    Bot(cfg).serve()
    return 0


def main():
    args = sys.argv[1:]
    commands = {"setup": cmd_setup, "run": cmd_run, "send": cmd_send, "claude": cmd_claude,
                "test": cmd_test, "mode": cmd_mode, "unlock": cmd_unlock, "lockdown": cmd_lockdown,
                "session": cmd_session, "claude-dir": cmd_claude_dir, "update": cmd_update}
    if not args or args[0] not in commands:
        print(__doc__.strip())
        return 0 if not args or args[0] in ("-h", "--help", "help") else 2
    return commands[args[0]](args[1:]) or 0


if __name__ == "__main__":
    sys.exit(main())
