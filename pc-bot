def render_card(html, chat_data="", width=400):
    """Draw a widget's HTML to a PNG with headless Chrome: Telegram's colours,
    a stand-in for the widget API, no network. Returns the path, or None."""
    browser = next((b for b in ("google-chrome-stable", "chromium", "chromium-browser", "google-chrome")
                    if shutil.which(b)), None)
    if not browser:
        return None
    work = os.path.join(RUNTIME, f"card-{uuid.uuid4().hex[:8]}")
    os.makedirs(work, mode=0o700)
    page, raw, png = (os.path.join(work, n) for n in ("card.html", "raw.png", "card.png"))
    css = ":root{" + ";".join(f"--tg-theme-{k}-color:{v}" for k, v in CARD_THEME.items()) + "}"
    css += f"html{{background:{CARD_THEME['bg']};width:{width}px;color-scheme:dark}}"
    # The data goes inside a <script>: escape what could end the tag early
    # (a window title is enough to try).
    data_js = json.dumps(chat_data or None).replace("<", "\\u003c").replace(">", "\\u003e") \
        .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029")
    stub = "<script>window.TelegramWidget={chatData:" + data_js + \
           ",publicData:null,colorScheme:'dark',onEvent:function(){},ready:function(){}}</script>"
    # The policy comes first, so nothing the card adds can loosen it (policies
    # only ever add up): no frames, no network, no files, only inline code and
    # data: images.
    policy = ("<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; "
              "style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:\">")
    with open(page, "w") as f:
        f.write(f"<!doctype html><meta charset=utf-8>{policy}<style>{css}</style>{stub}{html}")
    try:
        # Chrome runs inside bubblewrap: its own network namespace (no network
        # at all, raw IP addresses included) and no home folder, only the
        # card's own folder. A card can't send anything out or show your files.
        chrome = [browser, "--headless=new", "--disable-gpu", "--hide-scrollbars",
                  "--no-first-run", "--disable-dev-shm-usage", "--force-device-scale-factor=2",
                  f"--window-size={width},900", f"--user-data-dir={work}/profile",
                  "--virtual-time-budget=1500", f"--screenshot={raw}", "file://" + page]
        if not shutil.which("bwrap"):
            log("render skipped: bubblewrap (bwrap) isn't installed, and without it the card could reach the network")
            return None
        jail = ["bwrap", "--unshare-all", "--die-with-parent", "--new-session",
                "--ro-bind", "/usr", "/usr", "--ro-bind-try", "/opt", "/opt",
                "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64", "--symlink", "usr/bin", "/bin",
                "--dir", "/etc", "--ro-bind", "/etc/fonts", "/etc/fonts", "--ro-bind", "/etc/ld.so.cache", "/etc/ld.so.cache",
                "--ro-bind-try", "/etc/localtime", "/etc/localtime", "--ro-bind", "/etc/passwd", "/etc/passwd",
                "--ro-bind", "/etc/group", "/etc/group", "--ro-bind-try", "/etc/nsswitch.conf", "/etc/nsswitch.conf",
                "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/run",
                "--bind", work, work, "--setenv", "HOME", work, "--unsetenv", "DBUS_SESSION_BUS_ADDRESS"]
        subprocess.run(jail + chrome, capture_output=True, timeout=40)
        if not os.path.exists(raw):
            return None
        # Crop the empty space under the card, then give it an even margin.
        subprocess.run(["magick", raw, "-trim", "+repage", "-bordercolor", CARD_THEME["bg"],
                        "-border", "28", png], capture_output=True, timeout=20)
        final = os.path.join(RUNTIME, f"card-{uuid.uuid4().hex[:8]}.png")
        os.replace(png if os.path.exists(png) else raw, final)
        return final
    except (OSError, subprocess.SubprocessError) as e:
        log("render failed:", e)
        return None
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ---------------------------------------------------------------- helpers

def run(cmd, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def human_duration(seconds):
    seconds = int(seconds)
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m"


def battery():
    bats = sorted(glob.glob("/sys/class/power_supply/BAT*"))
    if not bats:
        return None
    b = bats[0]
    try:
        level = int(read(f"{b}/capacity", "0"))
    except ValueError:
        level = 0
    status = read(f"{b}/status", "Unknown")
    plugged = any(read(f"{a}/online") == "1" for a in glob.glob("/sys/class/power_supply/A*"))
    return {"level": level, "status": status, "plugged": plugged}


