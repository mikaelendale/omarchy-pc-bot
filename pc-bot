class ClaudeChat:
    """One conversation with Claude Code at a time, streamed into the chat as
    a live draft (Telegram shows it being written, with a stop button), then
    sent as a formatted message, plus any visual card Claude made.

    Access (cfg["claude"]["access"]):
      look  Claude can read files and search the web, but can't change anything.
      work  Claude Code in auto mode, as in your terminal: it runs commands and
            edits files, and its safety check blocks risky actions.
    The conversation carries on until /new, or after 12 hours of quiet.
    """

    IDLE_RESET = 12 * 3600
    TIMEOUT = 15 * 60

    def __init__(self, bot):
        self.bot = bot
        self.proc = None
        self.thread = None
        self.stopped = False
        self.draft_id = 0

    @property
    def state(self):
        return self.bot.cfg.setdefault("claude", {"access": "look"})

    @property
    def busy(self):
        return self.thread is not None and self.thread.is_alive()

    def ask(self, content, header=""):
        """content: Claude message content blocks. header: Markdown shown above
        the answer (what a voice note said). Runs in the background."""
        self.stopped = False
        self.draft_id = random.randint(1, 2**31 - 1)
        self.thread = threading.Thread(target=self.run, args=(content, header), daemon=True, name="claude")
        self.thread.start()

    def stop(self):
        """Stop Claude and everything it started (it runs in its own process group)."""
        self.stopped = True
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
                self.proc.wait(5)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                pass
            try:
                os.killpg(self.proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def new(self):
        self.stop()
        self.state.pop("session", None)
        save_config(self.bot.cfg)

    @staticmethod
    def view(header, text, doing):
        """The live draft: what Claude has written so far, and what it's doing."""
        cut = text.find("```widget")
        if cut >= 0:
            text, doing = text[:cut], doing or "Drawing a visual"
        text = safe_reply(text)
        parts = [header] if header else []
        if text.strip():
            parts.append(close_fences(text.strip()))
        if doing or not text.strip():
            parts.append(f"<tg-thinking>{doing or 'Thinking'}</tg-thinking>")
        return "\n\n".join(parts)

    def run(self, content, header):
        try:
            self._run(content, header)
        except Exception as e:
            log("claude: crashed:", repr(e))
            if self.proc and self.proc.poll() is None:
                self.proc.kill()
            try:
                self.bot.tg.send(self.bot.chat, f"**Claude hit an error:** {md(shorten(repr(e), 200))}")
            except Exception:
                pass

    def _run(self, content, header):
        tg, chat = self.bot.tg, self.bot.chat
        drafts = {"ok": True, "fails": 0}

        def show(markdown):
            if not drafts["ok"]:
                tg.typing(chat)
                return
            try:
                tg.draft(chat, self.draft_id, markdown)
                drafts["fails"] = 0
            except Exception as e:
                drafts["fails"] += 1
                log("draft failed:", e)
                if drafts["fails"] >= 3:
                    drafts["ok"] = False      # fall back to "typing…" for this answer

        show(self.view(header, "", ""))
        claude = find_claude()
        if not claude:
            tg.send(chat, "Claude Code isn't installed on the PC.")
            return

        st = self.state
        cmd = [claude, "-p", "--input-format", "stream-json", "--output-format", "stream-json",
               "--include-partial-messages", "--verbose", "--append-system-prompt", CHAT_PROMPT]
        if st.get("access") == "work":
            cmd += ["--permission-mode", "auto"]
        else:
            cmd += ["--tools", LOOK_TOOLS, "--allowedTools", LOOK_TOOLS]
        cmd += ["--disallowedTools"] + [f"{tool}({path})" for path in SECRETS for tool in ("Read", "Edit", "Write")]
        if st.get("session") and time.time() - st.get("at", 0) < self.IDLE_RESET:
            cmd += ["--resume", st["session"]]

        # The folder Claude works in (and whose CLAUDE.md and memory it loads):
        # your home unless set with `pc-bot claude-dir`.
        cwd = os.path.expanduser(st.get("dir") or "~")
        if not os.path.isdir(cwd):
            cwd = HOME
        env = dict(os.environ, PC_BOT_CHAT="1")   # so the Stop hook doesn't echo this chat back
        try:
            self.proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE, text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            tg.send(chat, f"Couldn't start Claude: {md(e.strerror)}")
            return
        self.proc.stdin.write(json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n")
        self.proc.stdin.close()
        killer = threading.Timer(self.TIMEOUT, self.proc.kill)
        killer.start()

        text, everything, doing, final, failed, session = "", "", "", None, None, None
        shown, last_draft = "", 0.0
        for line in self.proc.stdout:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            kind = d.get("type")
            if kind == "system" and d.get("subtype") == "init":
                session = d.get("session_id") or session
            elif kind == "stream_event":
                ev = d.get("event") or {}
                if ev.get("type") == "message_start":
                    if text.strip():
                        everything += text.strip() + "\n\n"
                    text = ""
                elif ev.get("type") == "content_block_start":
                    block = ev.get("content_block") or {}
                    if block.get("type") == "tool_use":
                        doing = TOOL_WORDS.get(block.get("name"), f"Using {block.get('name')}")
                elif ev.get("type") == "content_block_delta":
                    delta = ev.get("delta") or {}
                    if delta.get("type") == "text_delta":
                        text += delta.get("text", "")
                        doing = ""
            elif kind == "result":
                session = d.get("session_id") or session
                if d.get("is_error"):
                    failed = str(d.get("result") or d.get("subtype") or "it stopped")
                else:
                    final = str(d.get("result") or "")

            # A draft lives 30 seconds: update it when it changes, and keep it
            # alive while Claude is busy with tools.
            now = time.time()
            view = self.view(header, text, doing)
            if (view != shown and now - last_draft > 0.7) or now - last_draft > 12:
                show(view)
                shown, last_draft = view, now
        killer.cancel()
        self.proc.wait()

        if session:
            st["session"], st["at"] = session, time.time()
            save_config(self.bot.cfg)

        if self.stopped:
            partial = (everything + text).strip()
            cut = partial.find("```widget")
            partial = partial[:cut].strip() if cut >= 0 else partial
            reply = (close_fences(partial) + "\n\n" if partial else "") + "*Stopped.*"
        elif final is not None:
            reply = final.strip() or "*Claude finished without saying anything.*"
        elif failed:
            reply = f"**Claude couldn't finish.** {md(shorten(failed, 300))}"
        else:
            err = (self.proc.stderr.read() or "").strip().splitlines()
            reply = "**Claude stopped without answering.**" + (f" {md(shorten(err[-1], 200))}" if err else "")

        cards = [] if self.stopped else [w.strip() for w in WIDGET_BLOCK.findall(reply) if w.strip()][:2]
        reply = safe_reply(WIDGET_BLOCK.sub("", reply)).strip() or "*Here it is:*"
        try:
            for part in chunks((header + "\n\n" if header else "") + reply):
                tg.send(chat, part)
            for html in cards:
                self.send_card(html)
        except Exception as e:
            log("claude: reply failed:", e)

    def send_card(self, html):
        """A visual Claude drew, as a Telegram widget (or a note if it won't fit)."""
        if len(html.encode()) > 32768 or zlib_size(html) > 4096:
            self.bot.tg.send(self.bot.chat, "*The visual was too big to show.*")
            return
        if not self.bot.send_visual(html):
            self.bot.tg.send(self.bot.chat, "*Couldn't draw the visual.*")


