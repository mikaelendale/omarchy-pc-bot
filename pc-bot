        self.next_id = 1
        self.auto_sent = {}         # their chat id -> times of automatic replies
        self.handled = {}           # their chat id -> last message you skipped (not shown again)
        self.bad_conns = set()

    @property
    def tg(self):
        return self.bot.tg

    @property
    def state(self):
        return self.bot.cfg.setdefault("inbox", {})

    @property
    def conn(self):
        return self.state.get("connection") or {}

    def paused(self):
        return self.bot.lockdown or bool(self.state.get("paused"))

    def auto(self, peer):
        return peer in (self.state.get("auto") or [])

    def say(self, text, loud=True):
        try:
            self.tg.send(self.bot.chat, text, silent=not loud)
        except Exception as e:
            log("inbox: couldn't tell you:", e)

    # ---- the connection

    def on_connection(self, c):
        user = c.get("user") or {}
        uid = user.get("id")
        if uid != self.bot.chat:
            # Anyone can connect a bot that has business mode to their own account.
            self.bad_conns.add(c.get("id"))
            if c.get("is_enabled"):
                who = user.get("username") or user.get("first_name") or "someone"
                self.bot.event(f"**Someone else connected the bot to their Telegram account:** {md(who)} "
                               f"(id {uid}). Ignored; nothing of theirs is read.",
                               important=True, kind=f"biz-{uid}", every=3600)
            return
        rights = c.get("rights") or {}
        old = dict(self.conn)
        new = {"id": c.get("id"), "enabled": bool(c.get("is_enabled")), "name": user.get("first_name") or "Me",
               "reply": bool(rights.get("can_reply") or c.get("can_reply")),    # older field, still sent
               "read": bool(rights.get("can_read_messages")),
               "delete": bool(rights.get("can_delete_sent_messages") or rights.get("can_delete_all_messages"))}
        self.state["connection"] = new
        save_config(self.bot.cfg)
        log(f"inbox: connection {'on' if new['enabled'] else 'off'}, reply {new['reply']}")
        if not new["enabled"]:
            self.say("**Disconnected from your Telegram.** Your chats no longer come here.")
        elif old.get("id") == new["id"] and old.get("enabled"):
            self.say("**Chatbot settings changed.** " + ("The bot can reply for you." if new["reply"] else INBOX_REPLY_OFF))
        else:
            self.say(INBOX_CONNECTED + ("" if new["reply"] else "\n\n" + INBOX_REPLY_OFF))

    def known(self, cid):
        """True for messages through your own, active connection."""
        if not cid or cid in self.bad_conns:
            return False
        if cid != self.conn.get("id"):
            # Connected while the bot was off and the update got lost: ask whose it is.
            try:
                self.on_connection(self.tg.call("getBusinessConnection", {"business_connection_id": cid}))
            except TelegramError as e:
                log("inbox: unknown connection:", e)
                self.bad_conns.add(cid)
                return False
            except Exception as e:
                log("inbox: couldn't check a connection:", e)
                return False
        return cid == self.conn.get("id") and bool(self.conn.get("enabled"))

    # ---- the log of each chat (only what arrived since the bot was connected)

    def path(self, peer):
        return os.path.join(INBOX_DIR, f"{int(peer)}.jsonl")

    def history(self, peer):
        out = []
        try:
            with open(self.path(peer)) as f:
                for line in f:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
        except OSError:
            pass
        return out

    def change(self, peer, fn):
        """Rewrite one chat's log through fn(entries) -> entries."""
        with self.lock:
            entries = fn(self.history(peer))
            os.makedirs(INBOX_DIR, mode=0o700, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=INBOX_DIR, prefix=".chat-", suffix=".tmp")
            try:
                with os.fdopen(fd, "w") as f:
                    f.writelines(json.dumps(e, ensure_ascii=False) + "\n" for e in entries[-self.KEEP:])
                os.replace(tmp, self.path(peer))
            except BaseException:
                if os.path.exists(tmp):
                    os.unlink(tmp)
                raise

    def add(self, peer, entry):
        """Append a message; False if it's already there (our own sends come back)."""
        added = []

        def fn(entries):
            if any(e.get("id") == entry["id"] for e in entries):
                return entries
            added.append(True)
            return entries + [entry]
        self.change(peer, fn)
        return bool(added)

    def names(self):
        out = {}
        for path in glob.glob(os.path.join(INBOX_DIR, "*.jsonl")):
            try:
                peer = int(os.path.basename(path)[:-6])
            except ValueError:
                continue
            out[peer] = next((e["n"] for e in reversed(self.history(peer)) if e.get("n")), str(peer))
        return out

    # ---- updates

    def on_message(self, msg, edited=False):
        if not self.known(msg.get("business_connection_id")):
            return
        chat = msg.get("chat") or {}
        peer = chat.get("id")
        if chat.get("type") != "private" or not isinstance(peer, int) or not isinstance(msg.get("message_id"), int):
            return
        who = msg.get("from") or {}
        mine = who.get("id") == self.bot.chat
        entry = {"id": msg["message_id"], "t": int(msg.get("date") or time.time()), "me": mine, "text": describe(msg)}
        if not mine:
            entry["n"] = person(chat)
            if who.get("is_bot"):
                entry["robot"] = True        # another bot's messages: never waiting on you
        if msg.get("sender_business_bot"):
            entry["bot"] = True
        if msg.get("voice"):
            entry["voice"], entry["dur"] = msg["voice"].get("file_id"), msg["voice"].get("duration", 0)
        if edited:
            keep = ("text",)
            self.change(peer, lambda es: [dict(e, **{k: entry[k] for k in keep}) if e.get("id") == entry["id"] else e
                                          for e in es])
            return
        if not self.add(peer, entry):
            return
        if mine:
            if not entry.get("bot"):
                self.answered(peer)          # you replied yourself
            return
        if who.get("is_bot") or self.paused():
            return
        self.schedule(peer)

    def on_deleted(self, d):
        if not self.known(d.get("business_connection_id")):
            return
        peer = (d.get("chat") or {}).get("id")
        ids = set(d.get("message_ids") or [])
        if not isinstance(peer, int) or not ids:
            return
        self.change(peer, lambda es: [e for e in es if e.get("id") not in ids])
        with self.lock:
            c = self.cards.get(self.open.get(peer))
        if c and c["state"] in self.OPEN:
            c["msgs"] = [m for m in c["msgs"] if m.get("id") not in ids]
            if c["msgs"]:
                self.show(c)
            else:
                self.close(c)                # they took it all back

    def answered(self, peer):
        with self.lock:
            t = self.timers.pop(peer, None)
            if t:
                t.cancel()
            c = self.cards.get(self.open.get(peer))
        if c and c["state"] in self.OPEN:
            self.close(c)

    def close(self, c):
        with self.lock:
            c["state"] = "gone"
            if self.open.get(c["peer"]) == c["id"]:
                del self.open[c["peer"]]
        if c.get("mid"):
            self.tg.delete(self.bot.chat, c["mid"])

    # ---- writing replies

    def schedule(self, peer):
        wait = self.WAIT_AUTO if self.auto(peer) else self.WAIT
        with self.lock:
            old = self.timers.get(peer)
            if old:
                old.cancel()
            t = threading.Timer(wait, self.fire, args=(peer,))
            t.daemon = True
            self.timers[peer] = t
        t.start()

    def fire(self, peer):
        with self.lock:
            if self.timers.get(peer) is not threading.current_thread():
                return                       # a newer message restarted the wait
            del self.timers[peer]
        self.put({"peer": peer})

    def put(self, job):
        try:
            self.jobs.put_nowait(job)
        except queue.Full:
            log("inbox: too many replies waiting; dropped one")

    def worker(self):
        """One reply at a time, so a flood of messages can't start a flood of Claudes."""
        while not self.bot.stopping.is_set():
            try:
                job = self.jobs.get(timeout=5)
            except queue.Empty:
                continue
            try:
                if job.get("catchup"):
                    self.catchup(job.get("peer"), job.get("mid"), bool(job.get("daily")))
                else:
                    self.draft(**job)
            except Exception as e:
                log("inbox: draft failed:", repr(e))

    def new_card(self, peer, fresh, auto):
        with self.lock:
            old = self.cards.get(self.open.get(peer))
            cid, self.next_id = self.next_id, self.next_id + 1
            c = {"id": cid, "peer": peer, "name": fresh[-1].get("n") or "Someone", "msgs": fresh,
                 "state": "writing", "mid": None}
            self.cards[cid] = c
            self.open[peer] = cid
            for k in sorted(self.cards)[:-self.CARDS]:
                del self.cards[k]
        if old and old["state"] in self.OPEN:
            self.close(old)                  # the new card covers those messages too
            self.open[peer] = cid
        if not auto:
            self.show(c)
        return c

    def draft(self, peer, card=None, instruction=None, voice=None, again=False, force=False, manual=False):
        """manual: you asked for this draft (from /catchup), so it waits for you
        even if that person has auto-reply."""
        if self.paused():
            return
        c = self.cards.get(card) if card else None
        if card and (not c or c["state"] == "gone"):
            return
        if voice:
            try:
                instruction = self.hear(voice)
            except Exception as e:
                c["state"], c["error"] = "error", f"Couldn't hear your voice note: {e}"
                self.show(c)
                return
        entries = self.history(peer)
        mine = sum(1 for e in entries if e.get("me"))
        last = max((i for i, e in enumerate(entries) if e.get("me")), default=-1)
        skipped = self.handled.get(peer, 0)
        fresh = [e for e in entries[last + 1:] if not e.get("me") and e.get("id", 0) > skipped]
        auto = False
        if c is None:
            if not fresh:
                return                       # you answered in the meantime
            auto = self.auto(peer) and not manual
            c = self.new_card(peer, fresh, auto)
        if instruction:
            c["instruction"], c["tried"] = instruction, []
        self.listen(peer, entries)
        tried = c.get("tried", []) if again else []

        name = self.conn.get("name") or "Me"
        system = REPLY_PROMPT.replace("{skip_rule}", SKIP_AUTO if auto else SKIP_NEVER).replace("{name}", name)
        try:
            out, err = self.ask_claude(system, self.prompt(entries, c["name"], c.get("instruction"), tried, force,
                                                           peer=peer)), None
        except Exception as e:
            out, err = "", str(e)
        with self.lock:
            if c["state"] == "gone":
                return                       # skipped, replaced or answered while Claude wrote
            self.open[peer] = c["id"]
        c.pop("sent_id", None)
        c.pop("note", None)
        if err:
            c["state"], c["error"] = "error", f"Claude couldn't write a reply: {shorten(err, 200)}"
            self.show(c, loud=auto)
            return
        reply = clean_reply(out)
        # They asked if this is AI: Claude never says no for you. It answers the
        # rest (if there is any), and the card tells you; auto-reply holds it.
        c["ai"] = reply.upper().startswith(AI_TAG)
        if c["ai"]:
            reply = clean_reply(reply[len(AI_TAG):])
        if not reply or reply.upper().startswith("[SKIP]"):
            c["state"], c["left"] = "nothing", auto
            self.show(c, loud=auto or c["ai"])     # left to you: tell you
            return
        c["draft"] = reply[:4096]
        c["tried"] = tried + [c["draft"]]
        if auto and c["ai"]:
            c["note"] = "Held for you instead of sent automatically."
        elif auto:
            if sum(1 for e in self.history(peer) if e.get("me")) != mine:
                self.close(c)                # you answered while Claude was writing
                return
            if not self.auto_ok(peer):
                c["note"] = "Auto-reply is holding off: it already answered them a lot in the last 10 minutes."
            else:
                ok, why = self.send_now(c, auto=True)
                if ok:
                    c["state"] = "auto"
                    self.show(c)
                    return
                c["note"] = why
        c["state"] = "ready"
        self.show(c, loud=auto or c["ai"])

    def prompt(self, entries, them, instruction=None, tried=(), force=False, peer=None):
        name = self.conn.get("name") or "Me"
        if them == name:
            them += " (the other person)"
        lines = [json.dumps({"time": stamp(e.get("t", 0)), "from": name if e.get("me") else them,
                             "text": str(e.get("text", ""))[:2000]}, ensure_ascii=False)
                 for e in entries[-self.CONTEXT:]]
        notes = self.state.get("style") or {}
        style = [n for n in (notes.get("all"), notes.get(str(peer))) if n]
        ask = f"Write {name}'s next message."
        if style:
            ask = f"{name}'s own notes on how they text with this person: " + " ".join(style) + "\n\n" + ask
        if instruction:
            ask = ask.rsplit("\n\n", 1)[0] + "\n\n" if style else ""
            ask += (f"{name} wants this reply to say (these are {name}'s words to you, not to the other person): "
                   f"{instruction}\nWrite it as {name}'s message, in the conversation's language and {name}'s style. "
                   "Don't output [SKIP].")
        elif force:
            ask += " Write one even if no reply is strictly needed; don't output [SKIP]."
        if tried:
            ask += "\nMake it different from these earlier drafts:\n" + "\n".join(f"- {t}" for t in tried[-3:])
        return f"The chat so far, oldest first. It's now {stamp(time.time())}.\n\n" + "\n".join(lines) + "\n\n" + ask

    def ask_claude(self, system, text):
        claude = find_claude()
        if not claude:
            raise RuntimeError("Claude Code isn't installed")
        cwd = os.path.join(RUNTIME, "inbox-claude")      # empty: no CLAUDE.md, no project settings
        os.makedirs(cwd, mode=0o700, exist_ok=True)
        cmd = [claude, "-p", "--model", str(self.state.get("model") or "sonnet"), "--system-prompt", system,
               "--tools", "", "--strict-mcp-config", "--setting-sources", "project,local",
               "--no-session-persistence", "--disable-slash-commands", "--output-format", "json"]
        try:
            out = subprocess.run(cmd, input=text, capture_output=True, text=True, timeout=self.TIMEOUT, cwd=cwd,
                                 env=dict(os.environ, PC_BOT_CHAT="1"), start_new_session=True)
        except subprocess.TimeoutExpired:
            raise RuntimeError("it took too long") from None
        try:
            d = json.loads(out.stdout or "{}")
        except ValueError:
            d = {}
        if d.get("is_error") or not isinstance(d.get("result"), str):
            why = d.get("result") or ((out.stderr or "").strip().splitlines() or ["no answer"])[-1]
            raise RuntimeError(str(why))
        return d["result"]

    def hear(self, file_id):
        os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
        path = os.path.join(RUNTIME, f"inbox-voice-{uuid.uuid4().hex}.ogg")
        try:
            with open(path, "wb") as f:
                f.write(self.tg.download(file_id))
            return transcribe(path)
        finally:
            if os.path.exists(path):
                os.unlink(path)

    def listen(self, peer, entries):
        """Their voice notes to text (once each), for Claude and the card."""
        done = {}
        for e in [e for e in entries[-self.CONTEXT:] if e.get("voice") and not e.get("heard")][-5:]:
            e["heard"] = True
            if e.get("dur", 0) <= 300:
                try:
                    e["text"] = e["text"].replace("[voice note]", "[voice note] " + self.hear(e["voice"]), 1)
                except Exception as ex:
                    log("inbox: voice note:", ex)
            done[e["id"]] = {"text": e["text"], "heard": True}
        if done:
            self.change(peer, lambda es: [dict(e, **done[e["id"]]) if e.get("id") in done else e for e in es])
            with self.lock:
                c = self.cards.get(self.open.get(peer))
            for m in (c or {}).get("msgs", []):
                if m.get("id") in done:
                    m.update(done[m["id"]])

    def auto_ok(self, peer):
        n, window = self.AUTO_LIMIT
        now = time.time()
        self.auto_sent[peer] = [t for t in self.auto_sent.get(peer, []) if now - t < window]
        return len(self.auto_sent[peer]) < n

    def send_now(self, c, auto=False):
        """Send the card's reply as you. (ok, why not)"""
        conn = self.conn
        if self.paused():
            return False, "Paused: /inbox turns it back on." if not self.bot.lockdown else "Locked down."
        if not conn.get("enabled"):
            return False, "The bot isn't connected to your Telegram anymore."
        if not conn.get("reply"):
            return False, ("Telegram Business doesn't let the bot reply yet: Settings, Telegram Business, "
                           "Chatbots, allow replying.")
        params = {"business_connection_id": conn["id"], "chat_id": c["peer"]}
        try:
            sent = self.tg.call("sendMessage", dict(params, text=c["draft"]))
        except TelegramError as e:
            hint = (" The bot can only reply within 24 hours of their last message."
                    if re.search(r"PEER|BUSINESS|24", str(e), re.I) else "")
            return False, f"Telegram refused it: {e}.{hint}"
        except Exception as e:
            return False, f"Couldn't reach Telegram: {e}"
        c["sent_id"], c["sent_at"] = sent.get("message_id"), time.time()
        if isinstance(c["sent_id"], int):
            self.add(c["peer"], {"id": c["sent_id"], "t": int(time.time()), "me": True, "bot": True,
                                 "text": c["draft"]})
        with self.lock:
            if self.open.get(c["peer"]) == c["id"]:
                del self.open[c["peer"]]
        if auto:
            self.auto_sent.setdefault(c["peer"], []).append(time.time())
        if conn.get("read") and c.get("msgs"):
            try:
                self.tg.call("readBusinessMessage", dict(params, message_id=c["msgs"][-1]["id"]), timeout=10)
            except Exception as e:
                log("inbox: couldn't mark read:", e)
        return True, ""

    # ---- cards

    def card_text(self, c):
        msgs = c["msgs"]
        lines = [f"**{md(c['name'])}**" + (f" · {when(msgs[-1]['t'])}" if msgs else "")]
        shown = msgs[-6:]
        if len(msgs) > len(shown):
            lines.append(f"*{len(msgs) - len(shown)} earlier messages*")
        lines.append("\n>\n".join("> " + escape(re.sub(r"\s+", " ", m.get("text", ""))[:1500]) for m in shown))
        draft = "\n".join(escape(line) for line in c.get("draft", "").splitlines() if line.strip())
        st = c["state"]
        foot = {"writing": "*Writing a reply...*",
                "ready": "**Reply**\n" + draft,
                "sending": "*Sending...*",
                "nothing": (f"**{md(self.first(c))} asked if this is AI.** Claude won't say no for you, so this "
                            "one's yours to answer." if c.get("ai")
                            else "**Left for you:** Claude didn't answer this one." if c.get("left")
                            else "*Claude would leave this one unanswered.*"),
                "sent": f"**Sent** · {when(c.get('sent_at') or time.time())}\n" + draft,
                "auto": f"**Sent automatically** · {when(c.get('sent_at') or time.time())}\n" + draft,
                "error": f"*{md(c.get('error') or 'Something went wrong.')}*"}.get(st, "")
        if c.get("instruction") and st in ("ready", "writing"):
            foot = f"*You asked:* {md(shorten(c['instruction'], 200))}\n\n" + foot
        if c.get("ai") and st == "ready":
            foot = (f"**{md(self.first(c))} asked if this is AI.** Claude answered the rest and left that "
                    "question to you.\n\n" + foot)
        if c.get("note") and st == "ready":
            foot += f"\n\n*{md(c['note'])}*"
        return "\n".join(lines) + "\n\n" + foot

    @staticmethod
    def first(c):
        return (EMOJI.sub("", c["name"]).split() or ["They"])[0][:16]

    def card_buttons(self, c):
        i, st = c["id"], c["state"]
        auto = [(f"Auto-reply to {self.first(c)}: {'on' if self.auto(c['peer']) else 'off'}", f"ib:auto:{i}")]
        if st == "ready":
            return [[("Send", f"ib:send:{i}"), ("Another", f"ib:redo:{i}"), ("Skip", f"ib:skip:{i}")], auto]
        if st == "nothing" and c.get("ai"):
            return [[("Dismiss", f"ib:skip:{i}")]]
        if st == "nothing":
            return [[("Write one", f"ib:redo:{i}"), ("Dismiss", f"ib:skip:{i}")], auto]
        if st == "error":
            return [[("Try again", f"ib:redo:{i}"), ("Dismiss", f"ib:skip:{i}")]]
        if st == "writing":
            return [[("Skip", f"ib:skip:{i}")]]
        if st in ("sent", "auto"):
            rows = [[("Unsend", f"ib:undo:{i}")]] if self.conn.get("delete") and c.get("sent_id") else []
            return rows + ([auto] if st == "auto" else [])
        return []

    def show(self, c, loud=False):
        """Draw a card, or redraw it. Silent unless it needs you: Telegram already
        told you about the message itself."""
        text, buttons = self.card_text(c), self.card_buttons(c)
        if loud and c.get("mid") and not c.get("pinged"):
            # An edit never notifies: post it again so this one reaches you.
            self.tg.delete(self.bot.chat, c["mid"])
            c["mid"] = None
        c["pinged"] = c.get("pinged") or loud
        try:
            if c.get("mid"):
                self.tg.edit(self.bot.chat, c["mid"], text, buttons)
            else:
                c["mid"] = self.tg.send(self.bot.chat, text, buttons=buttons, silent=not loud).get("message_id")
        except Exception as e:
            log("inbox: card failed:", e)

    def card_for(self, mid):
        if not mid:
            return None
        with self.lock:
            return next((c for c in self.cards.values() if c.get("mid") == mid and c["state"] != "gone"), None)

    def on_instruction(self, c, text, voice=None):
        """You replied to a card: say what the reply should say."""
        if self.paused():
            return "*The inbox is paused.* /inbox turns it back on."
        if not text.strip() and not voice:
            return "*Reply to the card with text or a voice note saying what to answer.*"
        if c["state"] == "sending":
            return None
        c["state"] = "writing"
        if text.strip():
            c["instruction"] = text.strip()[:2000]
        self.show(c)
        self.put({"peer": c["peer"], "card": c["id"], "instruction": text.strip()[:2000] or None,
                  "voice": (voice or {}).get("file_id") if not text.strip() else None})
        return None

    def on_button(self, data, mid):
        parts = data.split(":")
        action = parts[1] if len(parts) > 1 else ""
        arg = parts[2] if len(parts) > 2 else ""
        if action in ("pause", "resume"):
            self.state["paused"] = action == "pause"
            save_config(self.bot.cfg)
            self.tg.edit(self.bot.chat, mid, self.status_text(), self.status_buttons())
            return "Paused" if action == "pause" else "On"
        if action == "autooff":
            try:
                peer = int(arg)
            except ValueError:
                return "Unknown button"
            if peer in (self.state.get("auto") or []):
                self.state["auto"].remove(peer)
                save_config(self.bot.cfg)
            self.tg.edit(self.bot.chat, mid, self.status_text(), self.status_buttons())
            return "Auto-reply off"
        if action == "cu":
            # From /catchup: a card with a draft for that person, waiting for you.
            try:
                peer = int(arg)
            except ValueError:
                return "Unknown button"
            if self.paused():
                return "The inbox is paused. /inbox turns it back on."
            if not self.waiting(self.history(peer)):
                return "Nothing from them is waiting anymore."
            self.handled.pop(peer, None)
            self.put({"peer": peer, "force": True, "manual": True})
            return "Writing a reply..."
        try:
            c = self.cards[int(arg)]
        except (ValueError, KeyError):
            c = None
        if not c or c.get("mid") != mid or c["state"] == "gone":
            try:
                self.tg.call("editMessageReplyMarkup", {"chat_id": self.bot.chat, "message_id": mid,
                                                        "reply_markup": {"inline_keyboard": []}}, timeout=10)
            except Exception:
                pass
            return "That card is old (the bot restarted). Answer in Telegram."
        if action == "send":
            with self.lock:
                if c["state"] != "ready":
                    return "Already handled."
                c["state"] = "sending"
            self.show(c)
            ok, why = self.send_now(c)
            if ok:
                c["state"] = "sent"
                self.show(c)
                return "Sent"
            c["state"], c["note"] = "ready", why
            self.show(c)
            return "Not sent"
        if action == "redo":
            if c["state"] not in ("ready", "nothing", "error"):
                return "Already handled."
            force = c["state"] == "nothing"
            c["state"] = "writing"
            self.show(c)
            self.put({"peer": c["peer"], "card": c["id"], "again": True, "force": force})
            return ""
        if action == "skip":
            if c["msgs"]:
                self.handled[c["peer"]] = max([self.handled.get(c["peer"], 0)] + [m["id"] for m in c["msgs"]])
            self.close(c)
            return "Left for you"
        if action == "undo":
            if c["state"] not in ("sent", "auto") or not c.get("sent_id"):
                return "Nothing to unsend."
            try:
                self.tg.call("deleteBusinessMessages", {"business_connection_id": self.conn.get("id"),
                                                        "message_ids": [c["sent_id"]]})
            except TelegramError as e:
                return shorten(f"Couldn't unsend: {e}", 190)
            gone = c.pop("sent_id")
            self.change(c["peer"], lambda es: [e for e in es if e.get("id") != gone])
            with self.lock:
                c["state"] = "ready"
                self.open[c["peer"]] = c["id"]
            self.show(c)
            return "Unsent"
        if action == "auto":
            lst = self.state.setdefault("auto", [])
            on = c["peer"] not in lst
            if on:
                lst.append(c["peer"])
            else:
                lst.remove(c["peer"])
            save_config(self.bot.cfg)
            self.show(c)
            return (f"Auto-reply on: Claude answers {shorten(c['name'], 30)} right away; you still see each reply here."
                    if on else "Auto-reply off: replies wait for you.")
        return "Unknown button"

    def match(self, who):
        """The one chat whose name starts with `who`: (their id, name, None),
        or (None, None, why not)."""
        names = self.names()
        hits = [p for p, n in names.items() if n.lower().startswith(who.lower())]
        if len(hits) != 1:
            known = ", ".join(md(n.split()[0]) for n in names.values()) or "nobody yet"
            return None, None, (f"*{'More than one chat' if hits else 'No chat'} matches {md(who)}.* "
                                f"Chats so far: {known}")
        return hits[0], names[hits[0]], None

    # ---- /catchup: who's waiting on you

    def waiting(self, entries):
        """Their messages since you last wrote."""
        last = max((i for i, e in enumerate(entries) if e.get("me")), default=-1)
        return [e for e in entries[last + 1:] if not e.get("me") and not e.get("robot")]

    def waiting_chats(self):
        """Chats where they wrote last, newest first, and how many more have
        been quiet too long to list."""
        now, chats, quiet = time.time(), [], 0
        for path in glob.glob(os.path.join(INBOX_DIR, "*.jsonl")):
            try:
                peer = int(os.path.basename(path)[:-6])
            except ValueError:
                continue
            entries = self.history(peer)
            new = self.waiting(entries)
            if not new:
                continue
            if now - new[-1].get("t", 0) > self.QUIET:
                quiet += 1
                continue
            chats.append({"peer": peer, "entries": entries, "new": new,
                          "name": next((e["n"] for e in reversed(entries) if e.get("n")), str(peer))})
        chats.sort(key=lambda c: c["new"][-1].get("t", 0), reverse=True)
        return chats, quiet

    def chat_lines(self, chat, shown, width=500):
        """A chat for Claude, as JSON lines: whatever a message says, it stays
        a message."""
        name = self.conn.get("name") or "Me"
        them = chat["name"] + (" (the other person)" if chat["name"] == name else "")
        new = {e.get("id") for e in chat["new"]}
        return "\n".join(json.dumps(dict({"time": stamp(e.get("t", 0)), "from": name if e.get("me") else them,
                                          "text": str(e.get("text", ""))[:width]},
                                         **({"new": True} if e.get("id") in new else {})), ensure_ascii=False)
                         for e in shown)

    def catchup_cmd(self, arg):
        """/catchup: who's waiting on you, summed up. /catchup NAME: one chat.
        /catchup daily 8:30: the first one every day, by itself."""
        if not self.conn.get("enabled"):
            return "*Not connected to your Telegram yet.* /inbox shows how."
        if self.bot.lockdown:
            return self.bot.LOCKED_DOWN
        words = arg.split()
        if words and words[0].lower() == "daily":
            return self.daily_cmd(" ".join(words[1:]))
        if self.paused():
            return "*The inbox is paused.* /inbox turns it back on."
        peer = None
        if arg:
            peer, _, why = self.match(arg)
            if why:
                return why
        elif not self.waiting_chats()[0]:
            return self.digest()[0]              # all caught up: nothing for Claude to read
        try:
            mid = self.tg.send(self.bot.chat, "*Catching up...*", silent=True).get("message_id")
        except Exception:
            mid = None
        self.put({"catchup": True, "peer": peer, "mid": mid})
        return None

    def daily_cmd(self, arg):
        arg = arg.strip().lower()
        if not arg:
            at = self.state.get("daily")
            return (f"**Daily catch-up at {at}.** `/catchup daily off` stops it." if at else
                    "**No daily catch-up.** `/catchup daily 8:30` sends one every day at that time, "
                    "if anyone is waiting on you.")
        if arg in ("off", "-", "stop", "no", "none"):
            self.state.pop("daily", None)
            save_config(self.bot.cfg)
            return "**Daily catch-up off.**"
        m = re.match(r"^(\d{1,2})(?:[:.h](\d{2}))?\s*(am|pm)?$", arg)
        hour, minute = (int(m.group(1)), int(m.group(2) or 0)) if m else (99, 0)
        if m and m.group(3):
            hour = hour % 12 + (12 if m.group(3) == "pm" else 0) if 1 <= hour <= 12 else 99
        if hour > 23 or minute > 59:
            return "Usage: `/catchup daily 8:30` (24-hour time), or `/catchup daily off`."
        at = f"{hour:02d}:{minute:02d}"
        self.state["daily"] = at
        # Already past that time today: the first one comes tomorrow.
        self.state["daily_done"] = time.strftime("%Y-%m-%d") if time.strftime("%H:%M") >= at else ""
        save_config(self.bot.cfg)
        return (f"**Daily catch-up at {at}.** It comes only when someone is waiting on you. "
                "`/catchup daily off` stops it.")

    def daily(self):
        """The daily catch-up: once a day, at the time you set or as soon after
        it as the PC is on."""
        while not self.bot.stopping.wait(30):
            at = self.state.get("daily")
            if not at or self.paused() or not self.conn.get("enabled"):
                continue
            today = time.strftime("%Y-%m-%d")
            if self.state.get("daily_done") == today or time.strftime("%H:%M") < at:
                continue
            self.state["daily_done"] = today
            save_config(self.bot.cfg)
            self.put({"catchup": True, "daily": True})

    def catchup(self, peer=None, mid=None, daily=False):
        """Write a catch-up and put it where the "Catching up..." message is."""
        if self.paused():
            return
        try:
            text, buttons = self.chat_summary(peer) if peer else self.digest(daily)
        except Exception as e:
            log("inbox: catch-up failed:", repr(e))
            text, buttons = f"*Couldn't catch up: {md(shorten(str(e), 200))}*", []
        if text is None:
            return                               # the daily one, and nobody is waiting
        try:
            if mid:
                self.tg.edit(self.bot.chat, mid, text, buttons)
                return
        except Exception as e:
            log("inbox: couldn't fill in the catch-up:", e)
        try:
            self.tg.send(self.bot.chat, text, buttons=buttons, silent=not daily)
        except Exception as e:
            log("inbox: couldn't send the catch-up:", e)

    def digest(self, daily=False):
        """(text, buttons) for /catchup; (None, None) when the daily one has
        nothing to tell you."""
        chats, quiet = self.waiting_chats()
        left_out = (f" {quiet} chat{'s' if quiet != 1 else ''} nobody has written in for two weeks "
                    f"{'is' if quiet == 1 else 'are'} left out.") if quiet else ""
        if not chats:
            return (None, None) if daily else ("**All caught up.** Nobody is waiting on you." + left_out, [])
        more = max(0, len(chats) - self.DIGEST)
        chats = chats[:self.DIGEST]
        for c in chats:
            first = c["entries"].index(c["new"][0])
            c["shown"] = c["entries"][max(0, first - 6):][-20:]      # a little of what came before, for context
        ask = (f"It's now {stamp(time.time())}.\n\n" +
               "\n\n".join(f"Chat {i}, with {json.dumps(c['name'], ensure_ascii=False)}:\n"
                           f"{self.chat_lines(c, c['shown'])}" for i, c in enumerate(chats, 1)) +
               f"\n\nWrite the {len(chats)} JSON lines.")
        notes, err = {}, ""
        try:
            name = self.conn.get("name") or "Me"
            notes = self.read_notes(self.ask_claude(CATCHUP_PROMPT.replace("{name}", name), ask), len(chats))
        except Exception as e:
            err = str(e)
        now, need, rest = time.time(), [], []
        for i, c in enumerate(chats, 1):
            note = notes.get(i) or {}
            # Claude's words about someone else's words: escaped below, never Markdown of their making.
            c["sum"] = note.get("summary") or shorten(str(c["new"][-1].get("text", "")), 160)
            c["urgent"] = bool(note.get("urgent"))
            c["late"] = now - c["new"][-1].get("t", 0) > self.WINDOW
            (need if note.get("reply", True) else rest).append(c)
        need.sort(key=lambda c: not c["urgent"])      # urgent first; otherwise newest first
        n = len(need)
        out = ["### Catch-up", (f"**{n} {'person is' if n == 1 else 'people are'} waiting on you.**" if n
                                else "**Nobody needs an answer right now.**")]
        for c in need:
            k = len(c["new"])
            out.append(f"\n**{md(c['name'])}** · {when(c['new'][-1].get('t', 0))} · {k} message{'s' if k != 1 else ''}"
                       + (" · **urgent**" if c["urgent"] else "") + "\n" + escape(c["sum"]))
        if rest:
            out.append("\n**No answer needed**\n" + "\n".join(f"- {md(c['name'])}: {escape(c['sum'])}" for c in rest))
        tail = []
        late = [md(self.first(c)) for c in need if c["late"]]
        if late:
            tail.append(f"{', '.join(late)} wrote more than a day ago. The bot can only send within 24 hours of "
                        "someone's last message, so answer in Telegram.")
        if more:
            tail.append(f"{more} more chat{'s' if more != 1 else ''} not shown.")
        if left_out:
            tail.append(left_out.strip())
        if err:
            tail.append(f"Claude couldn't sum these up ({md(shorten(err, 120))}), so this shows each person's "
                        "last message.")
        able = [(f"Draft for {self.first(c)}", f"ib:cu:{c['peer']}") for c in need if not c["late"]][:8]
        return ("\n".join(out) + "".join(f"\n\n*{t}*" for t in tail),
                [able[i:i + 2] for i in range(0, len(able), 2)])

    @staticmethod
    def read_notes(out, n):
        """Claude's catch-up lines -> {chat number: {"summary", "reply", "urgent"}}.
        Anything that isn't one of the n chats, or isn't the JSON asked for, is dropped."""
        text = re.sub(r"^```\w*\s*|\s*```$", "", (out or "").strip())
        try:
            whole = json.loads(text)
        except ValueError:
            whole = None
        items = whole if isinstance(whole, list) else [whole] if isinstance(whole, dict) else []
        if not items:
            for line in text.splitlines():
                a, b = line.find("{"), line.rfind("}")
                if 0 <= a < b:
                    try:
                        items.append(json.loads(line[a:b + 1]))
                    except ValueError:
                        pass
        notes = {}
        for d in items:
            if not isinstance(d, dict):
                continue
            i, s = d.get("chat"), d.get("summary")
            if type(i) is not int or not 1 <= i <= n or i in notes or not isinstance(s, str) or not s.strip():
                continue
            notes[i] = {"summary": shorten(s, 400), "reply": str(d.get("reply", "yes")).strip().lower() != "no",
                        "urgent": d.get("urgent") is True}
        return notes

    def chat_summary(self, peer):
        """(text, buttons) for /catchup NAME."""
        entries = self.history(peer)
        them = next((e["n"] for e in reversed(entries) if e.get("n")), str(peer))
        if not entries:
            return f"*Nothing in the chat with {md(them)} yet.*", []
        chat = {"peer": peer, "name": them, "entries": entries, "new": self.waiting(entries)}
        shown = entries[-self.SUMMARY:]
        name = self.conn.get("name") or "Me"
        ask = (f"It's now {stamp(time.time())}. {name}'s chat with {json.dumps(them, ensure_ascii=False)}:\n\n"
               f"{self.chat_lines(chat, shown, width=700)}\n\nWrite the lines.")
        try:
            out = self.ask_claude(SUMMARY_PROMPT.replace("{name}", name), ask)
        except Exception as e:
            return f"*Claude couldn't sum up the chat with {md(them)}: {md(shorten(str(e), 200))}*", []
        points = []
        for line in out.splitlines():
            line = re.sub(r"^\s*(?:[-*•–—]+|\d+[.)])\s*", "", line).replace("**", "").replace("`", "").strip()
            if line:
                points.append("- " + escape(shorten(line, 300)))     # their words, retold: never Markdown
        k = len(shown)
        text = (f"### {md(them)}\n*The last {k} message{'s' if k != 1 else ''}, from {when(shown[0].get('t', 0))}*\n\n"
                + ("\n".join(points[:8]) or "*Claude had nothing to say about it.*"))
        buttons, new = [], chat["new"]
        if new:
            k = len(new)
            text += (f"\n\n**Waiting on you:** {k} message{'s' if k != 1 else ''}, "
                     f"the last one {when(new[-1].get('t', 0))}.")
            if time.time() - new[-1].get("t", 0) > self.WINDOW:
                text += (" *That's more than a day ago, and the bot can only send within 24 hours of their "
                         "last message, so answer in Telegram.*")
            else:
                buttons = [[(f"Draft for {self.first(chat)}", f"ib:cu:{peer}")]]
        return text, buttons

    # ---- /style

    def style_cmd(self, arg):
        """/style NAME NOTE: how you text that person, for Claude. /style all NOTE
        for everyone; "-" clears one."""
        notes = self.state.setdefault("style", {})
        names = self.names()
        if not arg:
            rows = [f"| everyone | {md(notes['all'])} |"] if notes.get("all") else []
            rows += [f"| {md(names.get(int(k), k))} | {md(v)} |" for k, v in notes.items() if k != "all"]
            table = ("| Who | Note |\n|---|---|\n" + "\n".join(rows) + "\n\n") if rows else ""
            return ("### How Claude texts as you\n" + table +
                    "Tell Claude how you text someone: `/style Sam short, lowercase, no full stops`. "
                    "`/style all ...` is for everyone; `/style Sam -` clears it.")
        who, _, note = arg.partition(" ")
        note = note.strip()
        if who.lower() in ("all", "everyone"):
            key, label = "all", "everyone"
        else:
            peer, label, why = self.match(who)
            if why:
                return why
            key = str(peer)
        if note in ("", "-", "clear", "off"):
            notes.pop(key, None)
            save_config(self.bot.cfg)
            return f"**Style note cleared** for {md(label)}."
        notes[key] = note[:500]
        save_config(self.bot.cfg)
        return f"**Style note for {md(label)}:** {md(note[:500])}"

    # ---- /inbox

    def status_text(self):
        c = self.conn
        if not c.get("enabled"):
            try:
                me = self.tg.call("getMe")
            except Exception:
                me = {}
            name = "@" + md(me.get("username") or "your bot")
            steps = []
            if not me.get("can_connect_to_business"):
                steps.append(f"In @BotFather: /mybots, pick {name}, Bot Settings, and turn on Business Mode "
                             "(Telegram may call it Secretary Mode).")
            steps.append(f"In Telegram: Settings, Telegram Business, Chatbots (Chat Automation on the desktop app). "
                         f"Enter {name}, pick the chats, and allow it to reply to messages.")
            return ("### Your Telegram\n**Not connected.** Claude can answer your own chats from here once you:\n\n" +
                    "\n".join(f"{i}. {s}" for i, s in enumerate(steps, 1)))
        names = self.names()
        auto = [md(names.get(p, str(p))) for p in self.state.get("auto") or []]
        rows = [("Connected", f"as {md(c.get('name'))}"),
                ("Replying", "allowed" if c.get("reply") else "off in Telegram Business settings"),
                ("Auto-reply", ", ".join(auto) or "nobody, every reply waits for you"),
                ("Daily catch-up", f"at {self.state['daily']}" if self.state.get("daily") else "off"),
                ("Inbox", "locked down" if self.bot.lockdown else "paused" if self.paused() else "on")]
        table = "\n".join(f"| {k} | {v} |" for k, v in rows)
        return ("### Your Telegram\n| | |\n|---|---|\n" + table +
                "\n\n/catchup sums up who's waiting on you. Pick which chats come here in Telegram: "
                "Settings, Telegram Business, Chatbots.")

    def status_buttons(self):
        if not self.conn.get("enabled"):
            return []
        rows = [[("Resume", "ib:resume") if self.state.get("paused") else ("Pause", "ib:pause")]]
        names = self.names()
        offs = [(f"Auto off: {(EMOJI.sub('', names.get(p, str(p))).split() or ['?'])[0][:16]}", f"ib:autooff:{p}")
                for p in (self.state.get("auto") or [])[:6]]
        rows += [offs[i:i + 2] for i in range(0, len(offs), 2)]
        return rows


# ---------------------------------------------------------------- the service

class Bot:
    def __init__(self, cfg):
        self.cfg = cfg
        self.tg = Telegram(cfg["token"])
        self.chat = cfg["chat_id"]
        self.outbox = queue.Queue(maxsize=200)
        self.away = False
        self.locked = False
        self.last_sent = {}           # kind -> time, for throttling
        self.woke_at = 0.0
        self.strangers = set()
        self.last_root = ""
        self.fails = []               # wrong-password times, for counting
        self.claude = ClaudeChat(self)
        self.inbox = Inbox(self)
        self.widgets_retry_at = 0.0     # Telegram widgets roll out per bot; retry later if refused
        self.root = RootHelper()
        self.trusted_until = 0.0        # the bot is unlocked (a code was given) until then
        self.trust_gen = 0              # bumped by /logout and lockdown; late grants check it
        self.trust_started = 0.0
        self.pending = None             # waiting for a code: {"kind", "then"/"command", "at", "prompt"}
        self.stopping = threading.Event()

    # ---- what to send

    @property
    def mode(self):
        return self.cfg.get("mode", "away")

    def event(self, text, important=False, kind=None, every=0, away=None, buttons=None):
        """Queue an event if the mode allows it. `away` overrides the current
        away state (unlocking is judged by the state before it)."""
        was_away = self.away if away is None else away
        if not important:
            if self.mode == "quiet" or (self.mode == "away" and not was_away):
                return
        if kind and every:
            now = time.time()
            if now - self.last_sent.get(kind, 0) < every:
                return
            self.last_sent[kind] = now
        try:
            self.outbox.put_nowait((time.time(), text, buttons))
        except queue.Full:
            pass

    def sender(self):
        """Delivers the outbox; keeps retrying while offline, and stamps
        messages that arrive late with the time they happened."""
        backoff = 2
        pending = None
        while not self.stopping.is_set():
            if pending is None:
                try:
                    pending = self.outbox.get(timeout=1)
                except queue.Empty:
                    continue
            at, text, buttons = pending
            if time.time() - at > 120:
                text = f"*{time.strftime('%H:%M', time.localtime(at))}* · {text}"
            try:
                self.tg.send(self.chat, text, plain_entities=True, buttons=buttons)
                pending = None
                backoff = 2
            except Exception as e:
                log("send failed:", e)
                self.stopping.wait(backoff)
                backoff = min(backoff * 2, 120)

    # ---- watchers

    def watch_presence(self):
        """Locked / screensaver = away. Reports locking and unlocking."""
        first = True
        while not self.stopping.is_set():
            locked = is_locked()
            away = locked or screensaver_on()
            if not first:
                if locked and not self.locked:
                    self.event("**Locked**", kind="lock", away=self.away)
                elif self.locked and not locked:
                    self.event("**Unlocked**", kind="lock", away=True)
            self.locked, self.away, first = locked, away, False
            self.stopping.wait(3)

    def watch_power(self):
        last = battery()
        if not last:
            return
        warned = set()
        while not self.stopping.wait(15):
            now = battery()
            if not now:
                continue
            if now["plugged"] != last["plugged"]:
                self.event(f"**Charger in** at {now['level']}%" if now["plugged"]
                           else f"**Charger out** at {now['level']}%", kind="charger", every=20)
            if now["plugged"]:
                warned.clear()
                if now["status"] == "Full" and last["status"] != "Full":
                    self.event("**Battery full**", kind="full", every=3600)
            else:
                for level, important in ((5, True), (10, True), (20, False)):
                    if now["level"] <= level and level not in warned:
                        warned.update(l for l in (5, 10, 20) if l >= level)
                        self.event(f"**Battery at {now['level']}%** and not charging", important=important)
                        break
            last = now

    def watch_journal(self):
        """Follows the system journal; on_journal reads each entry."""
        proc = subprocess.Popen(
            ["journalctl", "-f", "-n", "0", "-o", "json",
             "--output-fields=MESSAGE,SYSLOG_IDENTIFIER,_TRANSPORT,_COMM"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        try:
            for line in proc.stdout:
                if self.stopping.is_set():
                    break
                try:
                    self.on_journal(json.loads(line))
                except ValueError:
                    continue
        finally:
            proc.kill()

    def on_journal(self, d):
        """Wrong passwords, crashes, USB devices, sleep and wake, from one journal entry."""
        msg = d.get("MESSAGE")
        if isinstance(msg, list):       # journald sends odd bytes as a list
            msg = bytes(msg).decode("utf-8", "replace")
        msg = str(msg or "")
        ident = str(d.get("SYSLOG_IDENTIFIER") or "")

        # Anchored, and never from the kernel: a USB device name or an SSH user
        # name containing this text must not raise a fake alert.
        m = (re.match(r"pam_unix\(([^:]+):auth\): authentication failure", msg)
             if d.get("_TRANSPORT") in ("syslog", "journal") else None)
        if m:
            service = m.group(1)
            where = {"omarchy-lock-password": "the lock screen", "sudo": "sudo in a terminal",
                     "polkit-1": "a system password prompt", "login": "the login screen",
                     "sshd": "SSH"}.get(service, service)
            now = time.time()
            self.fails = [t for t in self.fails if now - t < 600] + [now]
            count = f" · {len(self.fails)} times in 10 minutes" if len(self.fails) > 1 else ""
            self.event(f"**Wrong password** on {md(where)}{count}", important=True, kind=f"auth-{service}", every=20,
                       buttons=ALERT_BUTTONS)
            return

        if ident == "systemd-coredump":
            m = re.match(r"Process \d+ \(([^)]+)\) of user (\d+) (?:dumped core|terminated abnormally)", msg)
            if m and m.group(2) == str(os.getuid()):
                self.event(f"**Crashed:** {md(m.group(1))}", kind=f"crash-{m.group(1)}", every=300)
            return

        if d.get("_TRANSPORT") == "kernel":
            m = re.match(r"usb [\d.-]+: Product: (.+)", msg)
            if m and time.time() - self.woke_at > 30:
                product = m.group(1).strip()
                self.event(f"**USB device plugged in:** {md(product)}", important=self.away,
                           kind=f"usb-{product}", every=60, buttons=ALERT_BUTTONS if self.away else None)
            return

        if ident == "systemd-sleep":
            if msg.startswith("Performing sleep operation"):
                self.event("**Going to sleep**", kind="sleep", every=30)
            elif msg.startswith("System returned from sleep"):
                self.woke_at = time.time()
                self.event("**Woke up**", kind="wake", every=30, away=True)

    def watch_network(self):
        if not shutil.which("nmcli"):
            return
        proc = subprocess.Popen(["nmcli", "monitor"], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        last = None
        for line in proc.stdout:
            if self.stopping.is_set():
                break
            line = line.strip()
            m = re.match(r"'(.+)' is now the primary connection", line)
            if m and m.group(1) != last:
                last = m.group(1)
                self.event(f"**Connected** to {md(last)}", kind="net", every=10)
            elif line == "There's no primary connection" and last is not None:
                last = None
                self.event("**Offline**", kind="net", every=10)

    def watch_downloads(self):
        if not (shutil.which("inotifywait") and os.path.isdir(DOWNLOADS)):
            return
        proc = subprocess.Popen(
            ["inotifywait", "-m", "-q", "-e", "close_write", "-e", "moved_to", "--format", "%f", DOWNLOADS],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        batch, lock = {}, threading.Lock()

        def flush():
            with lock:
                names = list(batch)
                batch.clear()
            if not names:
                return
            if len(names) == 1:
                path = os.path.join(DOWNLOADS, names[0])
                size = human_size(os.path.getsize(path)) if os.path.exists(path) else ""
                self.event(f"**Downloaded** {md(names[0])}" + (f" · {size}" if size else ""))
            else:
                self.event(f"**{len(names)} downloads:** " + ", ".join(md(shorten(n, 40)) for n in names[:5]))

        timer = None
        for name in proc.stdout:
            name = name.strip()
            if (not name or name.startswith(".") or
                    re.search(r"\.(part|crdownload|tmp|download|partial|opdownload)$", name, re.I)):
                continue
            with lock:
                batch[name] = True
            if timer:
                timer.cancel()
            timer = threading.Timer(4, flush)
            timer.daemon = True
            timer.start()

    def watch_camera(self):
        on = False
        while not self.stopping.wait(5):
            devices = glob.glob("/dev/video*")
            users = set()
            if devices:
                for pid in run(["fuser"] + devices, timeout=3).split():
                    comm = read(f"/proc/{pid.rstrip('mcefr')}/comm")
                    if comm and comm not in ("pipewire", "wireplumber"):
                        users.add(comm)
            if users and not on:
                self.event(f"**Camera on** · {md(', '.join(sorted(users)))}", important=self.away, kind="camera", every=30,
                           buttons=ALERT_BUTTONS if self.away else None)
            elif on and not users:
                self.event("**Camera off**", kind="camera-off", every=30)
            on = bool(users)

    def watch_disk(self):
        while not self.stopping.wait(5):
            for path in sorted({"/", HOME}):
                try:
                    u = shutil.disk_usage(path)
                except OSError:
                    continue
                if u.used / u.total > 0.92:
                    self.event(f"**Disk almost full** · {human_size(u.free)} left", important=True,
                               kind="disk", every=86400)
            self.stopping.wait(6 * 3600)

    def watch_socket(self):
        """Events from scripts and hooks (pc-bot send / pc-bot claude)."""
        os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
        try:
            os.unlink(SOCKET)
        except OSError:
            pass
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.bind(SOCKET)
        os.chmod(SOCKET, 0o600)
        while not self.stopping.is_set():
            try:
                data = s.recv(16_384)
                d = json.loads(data)
                if d.get("action") == "unlock":
                    self.unlock_local()
                    continue
                if d.get("action") == "lockdown":
                    self.do_lockdown("from the PC")
                    self.tg.send(self.chat, self.LOCKED_DOWN)
                    continue
                if d.get("action") == "claude_dir":
                    self.claude.state["dir"] = str(d.get("dir") or "")
                    save_config(self.cfg)
                    continue
                if d.get("action") == "session":
                    m = max(UNLOCK_RANGE[0], min(UNLOCK_RANGE[1], int(d.get("minutes"))))
                    self.cfg.setdefault("security", {})["unlock_minutes"] = m
                    save_config(self.cfg)
                    continue
                self.event(str(d.get("text", ""))[:3500], important=bool(d.get("important")),
                           kind=d.get("kind"), every=int(d.get("every") or 0))
            except Exception as e:
                log("socket:", e)

    # ---- commands from your phone

    # ---- security: unlocking with a code, root, lockdown

    @property
    def lockdown(self):
        return bool(self.cfg.get("lockdown"))

    def security_on(self):
        """On once the root helper is installed. From then on the bot fails
        closed: if the helper stops answering, gated things stay locked (they
        ask for a code that can't be checked) instead of opening up."""
        return os.path.exists(ROOT)

    @property
    def unlock_minutes(self):
        try:
            m = int((self.cfg.get("security") or {}).get("unlock_minutes", UNLOCK_MINUTES))
        except (TypeError, ValueError):
            m = UNLOCK_MINUTES
        return max(UNLOCK_RANGE[0], min(UNLOCK_RANGE[1], m))

    def trust_cap(self):
        return max(TRUST_MAX, self.unlock_minutes * 60)

    def trusted(self):
        now = clock()
        return now < self.trusted_until and now - self.trust_started < self.trust_cap()

    def start_trust(self):
        if not self.trusted():
            self.trust_started = clock()
        self.trusted_until = clock() + self.unlock_minutes * 60

    def touch(self):
        if self.trusted():
            self.trusted_until = clock() + self.unlock_minutes * 60

    def gated(self, action, what):
        """Run `action` now if the bot is unlocked (or security isn't set up),
        otherwise ask for a code and run it once the code checks out."""
        if self.lockdown:
            return self.LOCKED_DOWN
        if not self.security_on() or self.trusted():
            self.touch()
            return action()
        self.ask_code("unlock", what=what, then=action)
        return None

    LOCKED_DOWN = ("**Locked down.** Remote control is off: no Claude, no screenshots, no root.\n\n"
                   "Turn it back on at the PC: `pc-bot unlock`")

    def ask_code(self, kind, what="", then=None, command=""):
        if self.pending and clock() - self.pending["at"] < 120:
            # A new request while one is waiting: cancel both. Replacing it
            # would let a second request (someone else in your Telegram
            # account) take the code you're about to type for the first one.
            if self.pending.get("prompt"):
                self.tg.delete(self.chat, self.pending["prompt"])
            self.pending = None
            self.tg.send(self.chat, "**Two requests arrived together, so I cancelled both.** "
                                    "Send the one you want again.")
            return
        if self.pending and self.pending.get("prompt"):
            self.tg.delete(self.chat, self.pending["prompt"])
        if kind == "sudo":
            text = ("### Run as root\n" + fenced(command, "bash") +
                    "\nSend the 6-digit code from your authenticator app to run exactly this. "
                    "The request expires in 2 minutes.")
        else:
            text = (f"### Unlock the bot\nTo {what}, send the 6-digit code from your authenticator app. "
                    f"The bot stays unlocked for {self.unlock_minutes} minutes after you last use it.")
        try:
            prompt = self.tg.send(self.chat, text, buttons=[[("Cancel", "code:cancel")]]).get("message_id")
        except Exception:
            prompt = None
        self.pending = {"kind": kind, "then": then, "command": command, "at": clock(), "prompt": prompt}

    def use_code(self, code):
        p, self.pending = self.pending, None
        if p.get("prompt"):
            self.tg.delete(self.chat, p["prompt"])
        if p["kind"] == "sudo":
            threading.Thread(target=self.run_root, args=(code, p["command"], self.trust_gen),
                             daemon=True, name="root").start()
            return
        r = self.root.call({"action": "verify", "code": code})
        if not r.get("ok"):
            self.code_failed(r, p)
            return
        self.start_trust()
        self.tg.send(self.chat, f"**Unlocked** for {self.unlock_minutes} minutes. /logout locks it now.")
        if p.get("then"):
            reply = p["then"]()
            if reply:
                self.tg.send(self.chat, reply)

    def code_failed(self, r, p):
        if r.get("disabled"):
            self.do_lockdown("wrong codes", tell_helper=False)
            self.event(f"**Remote control locked down** after wrong codes. {md(r.get('error', ''))}", important=True)
            return
        self.tg.send(self.chat, f"**{md(r.get('error', 'Wrong code.'))}**")
        if "already used" in r.get("error", "") or "Wrong code" in r.get("error", ""):
            self.pending = dict(p, at=clock(), prompt=None)     # let them try again

    def run_root(self, code, command, gen=None):
        draft = random.randint(1, 2**31 - 1)
        done = threading.Event()

        def keep_alive():
            first = True
            while not done.wait(0 if first else 12):
                first = False
                try:
                    self.tg.draft(self.chat, draft, f"*Running as root:* {md(shorten(command, 80))}\n\n"
                                                    "<tg-thinking>Running as root</tg-thinking>", can_stop=False)
                except Exception:
                    pass
        threading.Thread(target=keep_alive, daemon=True).start()
        try:
            r = self.root.call({"action": "run", "code": code, "command": command, "timeout": 300}, timeout=360)
        finally:
            done.set()
        if not r.get("ok"):
            self.code_failed(r, {"kind": "sudo", "command": command})
            return
        if gen == self.trust_gen and not self.lockdown:
            self.start_trust()             # not if you logged out or locked down meanwhile
        output = r.get("output", "").rstrip()
        head = ("**Timed out** after 300 s" if r.get("timed_out")
                else f"**Done** · exit 0 · {r.get('seconds')} s" if r.get("exit") == 0
                else f"**Failed** · exit {r.get('exit')} · {r.get('seconds')} s")
        cut = "\n*Showing the end; the full output is attached.*" if len(output) > 3500 or r.get("truncated") else ""
        body = (f"{head}\n" + fenced(command, "bash") + "\n" +
                (fenced(output[-3500:]) if output else "*No output.*") + cut)
        self.tg.send(self.chat, body, buttons=[[("Run again", "root:again")]])
        self.last_root = command
        if cut:
            try:
                self.tg.send_document(self.chat, "output.txt", output.encode(), caption=shorten(command, 200))
            except Exception as e:
                log("output file failed:", e)

    def do_lockdown(self, why, tell_helper=True):
        # Everything that takes effect in memory first; the helper next; the
        # config file last, so a failed save can't leave it half done.
        self.cfg["lockdown"] = True
        self.trusted_until = 0.0
        self.trust_gen += 1
        self.pending = None
        self.claude.state["access"] = "look"
        self.claude.stop()
        if tell_helper and os.path.exists(ROOT):
            self.root.call({"action": "lockdown"})
        try:
            save_config(self.cfg)
        except Exception as e:
            log("lockdown: couldn't save the config (lockdown still applies until restart):", e)
        log(f"lockdown: {why}")

    def unlock_local(self):
        self.cfg["lockdown"] = False
        save_config(self.cfg)
        self.tg.send(self.chat, "**Lockdown lifted** at the PC. Remote control is back; send your code to unlock the bot.")

    # ---- status

    def status_data(self):
        """The numbers behind /status, short keys so they fit a widget's 1 KB.
        Window titles only while the bot is unlocked."""
        b = battery() or {}
        used, total = memory()
        disk = shutil.disk_usage(HOME)
        wins = windows()
        front = next((w for w in wins if w.get("focusHistoryID") == 0), None)
        try:
            uptime = float(read("/proc/uptime", "0").split()[0])
        except ValueError:
            uptime = 0
        state = ("charging" if b.get("status") == "Charging" else "full" if b.get("status") == "Full"
                 else "plugged in" if b.get("plugged") else "on battery") if b else ""
        app = ""
        if front:
            app = shorten(front.get("class", "").split(".")[-1].replace("-", " ") or "?", 18)
            title = shorten(front.get("title", ""), 40)
            if title and (self.trusted() or not self.security_on()):
                app = f"{app}: {title}"
        t = cpu_temp()
        return {"h": socket.gethostname(), "u": int(uptime), "b": b.get("level"), "bs": state,
                "l": self.locked, "a": self.away, "w": shorten(wifi_name(), 32),
                "t": round(t) if t else None, "mu": used, "mt": total,
                "d": disk.used * 100 // disk.total, "f": app, "n": len(wins),
                "m": self.mode, "c": self.claude.state.get("access", "look")}

    def status_markdown(self, d):
        here = "Locked" if d["l"] else "Away" if d["a"] else "Here"
        rows = [("Battery", f"{d['b']}% · {d['bs']}" if d["b"] is not None else "No battery"),
                ("Wi-Fi", md(d["w"]) or "Offline"),
                ("Heat", f"{d['t']} °C" if d["t"] else "Unknown"),
                ("Memory", f"{human_size(d['mu'])} of {human_size(d['mt'])}"),
                ("Disk", f"{d['d']}% used"),
                ("In front", md(d["f"]) or "Nothing"),
                ("Windows", str(d["n"]))]
        table = "\n".join(f"| {k} | {v} |" for k, v in rows)
        return f"### {md(d['h'])}\n**{here}** · on for {human_duration(d['u'])}\n\n| | |\n|---|---|\n{table}"

    STATUS_BUTTONS = [[("Refresh", "m:status"), ("Screen", "m:screen"), ("Lock screen", "m:lock")]]

    def send_status(self):
        """A live widget when Telegram allows it, else the same card as an
        image, else a table."""
        d = self.status_data()
        data = json.dumps(d, separators=(",", ":"))
        if self.send_visual(STATUS_WIDGET, data, allow_queries=True, buttons=self.STATUS_BUTTONS):
            return
        self.tg.send(self.chat, self.status_markdown(d), plain_entities=True, buttons=self.STATUS_BUTTONS)

    def send_visual(self, html, chat_data="", allow_queries=False, buttons=None):
        """Show an HTML card: as a Telegram widget if the bot may send them
        (checked again every 6 hours), otherwise drawn as a photo."""
        if time.time() > self.widgets_retry_at:
            try:
                self.tg.widget(self.chat, html, chat_data=chat_data, allow_queries=allow_queries)
                return True
            except TelegramError as e:
                log("widget refused:", e)
                if "NOT_ALLOWED" in str(e):
                    self.widgets_retry_at = time.time() + 6 * 3600
        png = render_card(html, chat_data)
        if not png:
            return False
        try:
            self.tg.send_photo(self.chat, png, buttons=buttons)
            return True
        except Exception as e:
            log("card photo failed:", e)
            return False
        finally:
            os.unlink(png)

    def answer_widget_query(self, q):
        """The status card asks for fresh numbers every few seconds while it's on screen."""
        if (q.get("from") or {}).get("id") != self.chat:
            return
        data = json.dumps(self.status_data(), separators=(",", ":")) if q.get("data") == "status" else ""
        try:
            self.tg.answer_widget(q["id"], data)
        except Exception as e:
            log("widget answer failed:", e)

    # ---- the menu

    def security_line(self):
        if self.lockdown:
            return "**Locked down** · unlock at the PC with `pc-bot unlock`"
        if not self.security_on():
            return f"*Security setup not done* · run `{SETUP_CMD}`"
        if self.trusted():
            left = int(min(self.trusted_until, self.trust_started + self.trust_cap()) - clock()) // 60
            return f"**Unlocked** · locks in {max(1, left)} min"
        if not self.root.available():
            return "**Locked** · the root helper isn't answering"
        return f"**Locked** · your code unlocks it for {self.unlock_minutes} min"

    def menu_text(self):
        d = self.status_data()
        here = "Locked screen" if d["l"] else "Away" if d["a"] else "At the PC"
        bat = f"{d['b']}% {d['bs']}" if d["b"] is not None else "no battery"
        claude = "can run commands" if d["c"] == "work" else "can look, not change"
        return (f"### {md(d['h'])}\n{here} · {bat} · on for {human_duration(d['u'])}\n\n"
                f"| | |\n|---|---|\n| Security | {self.security_line()} |\n| Claude | {claude} |\n"
                f"| Events | {self.mode} |")

    def menu_buttons(self):
        access = self.claude.state.get("access", "look")
        events = {"away": "Events: away", "all": "Events: all", "quiet": "Events: quiet"}[self.mode]
        rows = [[("Status", "m:status"), ("Screen", "m:screen"), ("Windows", "m:apps")],
                [("Claude: " + ("Work" if access == "work" else "Look"), "m:claude"), ("New chat", "m:new"),
                 (events, "m:events")],
                [("Lock screen", "m:lock"), ("Lockdown", "m:lockdown")]]
        if self.trusted():
            rows[-1].append(("Lock bot", "m:logout"))
        return rows

    def send_menu(self, message_id=None):
        if message_id:
            self.tg.edit(self.chat, message_id, self.menu_text(), self.menu_buttons())
        else:
            self.tg.send(self.chat, self.menu_text(), plain_entities=True, buttons=self.menu_buttons())

    def on_callback(self, q):
        if (q.get("from") or {}).get("id") != self.chat:
            self.tg.answer_callback(q.get("id"), "Not yours.")
            return
        data = q.get("data") or ""
        mid = (q.get("message") or {}).get("message_id")
        toast = ""
        if data == "code:cancel":
            if self.pending:
                self.pending = None
            self.tg.delete(self.chat, mid)
            toast = "Cancelled"
        elif data == "root:again":
            cmd = getattr(self, "last_root", "")
            reply = self.handle(f"/sudo {cmd}") if cmd else "Nothing to run again."
            if reply:
                self.tg.send(self.chat, reply)
        elif data.startswith("ib:"):
            toast = self.inbox.on_button(data, mid) or ""
        elif data.startswith("m:"):
            what = data[2:]
            if what == "claude":
                new = "look" if self.claude.state.get("access") == "work" else "work"
                if new == "work":
                    reply = self.handle("/work")
                    if reply:
                        self.tg.send(self.chat, reply)
                else:
                    self.handle("/look")
                toast = "Claude: " + self.claude.state.get("access", "look")
                self.send_menu(mid)
            elif what == "events":
                order = ["away", "all", "quiet"]
                self.cfg["mode"] = order[(order.index(self.mode) + 1) % 3]
                save_config(self.cfg)
                toast = f"Events: {self.mode}"
                self.send_menu(mid)
            elif what == "status" and (q.get("message") or {}).get("photo"):
                self.tg.delete(self.chat, mid)        # refresh: replace the old card
                self.send_status()
            elif what in ("status", "screen", "apps", "lock", "lockdown", "new", "logout"):
                # Buttons map to a fixed set of commands. Button data is never
                # run as typed text: anyone holding the bot token can send
                # messages with buttons of their own making.
                reply = self.handle("/" + what)
                if reply:
                    self.tg.send(self.chat, reply)
                if what == "logout":
                    self.send_menu(mid)
            else:
                toast = "Unknown button"
        self.tg.answer_callback(q.get("id"), toast)

