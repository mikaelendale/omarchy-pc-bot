def cmd_update(_args):
    """Pull the latest pc-bot, restart it, and say if the root helper needs reinstalling."""
    if not os.path.isdir(os.path.join(HERE, ".git")):
        print(f"{HERE} isn't a git checkout; update it the way you installed it.")
        return 1
    before = run(["git", "-C", HERE, "rev-parse", "HEAD"])
    out = subprocess.run(["git", "-C", HERE, "pull", "--ff-only"], text=True)
    if out.returncode != 0:
        print("Couldn't update (local changes?). Nothing restarted.")
        return 1
    after = run(["git", "-C", HERE, "rev-parse", "HEAD"])
    if before == after:
        print("Already up to date.")
    else:
        print(run(["git", "-C", HERE, "log", "--oneline", f"{before}..{after}"], timeout=10))
        subprocess.run(["systemctl", "--user", "restart", "pc-bot"])
        print("pc-bot restarted.")
    for name in ("pc-bot-root", "pc-bot-root-admin"):
        installed = os.path.join(os.path.dirname(ROOT), name)
        if os.path.exists(installed):
            try:
                same = open(installed, "rb").read() == open(os.path.join(HERE, "root", name), "rb").read()
            except OSError:
                same = True
            if not same:
                print(f"The root helper changed. Reinstall it:\n  {SETUP_CMD} --update")
                break
    return 0


