def describe(msg):
    """A message as one line of text for Claude and the card: its text or
    caption, with a tag for whatever else it carries."""
    tag = ""
    for key, label in (("photo", "photo"), ("video", "video"), ("video_note", "video message"),
                       ("voice", "voice note"), ("audio", "audio"), ("animation", "GIF"),
                       ("sticker", "sticker"), ("document", "file"), ("location", "location"),
                       ("contact", "contact"), ("poll", "poll")):
        if msg.get(key):
            if key == "sticker":
                label = f"sticker {msg['sticker'].get('emoji', '')}".strip()
            elif key == "document":
                label = f"file {msg['document'].get('file_name', '')}".strip()
            elif key == "poll":
                label = f"poll: {msg['poll'].get('question', '')}"
            tag = f"[{label}]"
            break
    text = msg.get("text") or msg.get("caption") or ""
    if msg.get("forward_origin"):
        tag = "[forwarded] " + tag
    out = " ".join(filter(None, [tag.strip(), text]))
    reply = msg.get("reply_to_message")
    if reply:
        out = f'(replying to "{shorten(describe(reply), 80)}") ' + out
    return out or "[message]"


