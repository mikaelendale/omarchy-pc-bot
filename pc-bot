MD_SPECIAL = re.compile(r"([\\`*_{}\[\]()#+\-.!|~>=<$&@:])")


EMOJI = re.compile("[\U0001F000-\U0001FAFF\u2600-\u27BF\u2B00-\u2BFF\u23E9-\u23FF\u2190-\u21FF"
                   "\u25A0-\u25FF\uFE0F\u200D\u20E3]")


def md(value):
    """Text from outside (file names, Wi-Fi names, window titles) made safe
    to drop into Markdown, with any emoji or symbol glyphs taken out."""
    text = re.sub(r"\s+", " ", EMOJI.sub("", str(value))).strip()
    return MD_SPECIAL.sub(r"\\\1", text)


def fenced(text, lang=""):
    """Text shown verbatim in a code block. Backtick runs are broken with a
    zero-width space so the text can't close the block early and change what
    the card appears to say (what you approve must be what runs)."""
    return f"```{lang}\n" + re.sub(r"`{3,}", lambda m: "\u200b".join(m.group()), text) + "\n```"


# Things in Claude's replies that would make Telegram fetch a URL by itself
# (images, video, audio, documents: a way for injected text to send data out
# without you tapping anything) or draw buttons that press bot commands.
UNSAFE_MD = [re.compile(r"!\[([^\]\n]*)\]\([^)\n]*\)"),
             re.compile(r"<\s*/?\s*(img|video|audio|tg-document|tg-collage|tg-slideshow|tg-button|tg-button-row|"
                        r"figure|figcaption|source|iframe)\b[^>]*>", re.I)]


def safe_reply(text):
    """Outside code blocks: images become plain text (inline and reference
    style alike), and media/button HTML is dropped. Code blocks stay as written."""
    parts = re.split(r"(```.*?(?:```|$))", text, flags=re.S)
    for i in range(0, len(parts), 2):
        t = UNSAFE_MD[0].sub(lambda m: f"[image: {m.group(1)}]" if m.group(1).strip() else "", parts[i])
        t = t.replace("![", "!\\[")      # anything image-shaped that's left, e.g. ![x][ref]
        parts[i] = UNSAFE_MD[1].sub("", t)
    return "".join(parts)


def close_fences(text):
    """A reply cut off mid code block still renders while it streams."""
    return text + "\n```" if text.count("```") % 2 else text


def plain(text):
    """Markdown made readable as plain text (the fallback)."""
    text = re.sub(r"^```\w*\s*$", "", text, flags=re.M)
    text = re.sub(r"^#{1,6}\s+", "", text, flags=re.M)
    text = re.sub(r"\*\*(.+?)\*\*", r"\1", text)
    text = re.sub(r"(?<!\w)`([^`\n]+)`", r"\1", text)
    text = re.sub(r"\\([\\`*_{}\[\]()#+\-.!|~>=<$&@:])", r"\1", text)
    text = re.sub(r"</?tg-[a-z-]+[^>]*>", "", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def chunks(text, n=30000):
    """Split a long reply at paragraph or line breaks for Telegram's limit."""
    out = []
    while len(text) > n:
        cut = text.rfind("\n\n", 0, n)
        cut = cut if cut > n // 2 else text.rfind("\n", 0, n)
        cut = cut if cut > n // 2 else n
        out.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    return out + [text] if text else out


def transcribe(audio_path, timeout=90):
    """A voice note to text, through Superwhisper (the same engine as your dictation)."""
    if not shutil.which("superwhisper"):
        raise RuntimeError("Voice notes need Superwhisper, and it isn't installed.")
    try:
        started = json.loads(run(["superwhisper", "transcribe", audio_path], timeout=30) or "{}")
    except ValueError:
        started = {}
    session = started.get("session_id")
    if not started.get("ok") or session is None:
        raise RuntimeError("Superwhisper didn't take the voice note.")
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(0.6)
        try:
            last = json.loads(run(["superwhisper", "read"], timeout=10) or "{}")
        except ValueError:
            continue
        if last.get("session_id") == session:
            text = (last.get("text") or last.get("raw") or "").strip()
            if text:
                return text
            if last.get("warning"):
                raise RuntimeError(f"Couldn't hear anything: {last['warning'].lower()}.")
    raise RuntimeError("Transcribing took too long.")


