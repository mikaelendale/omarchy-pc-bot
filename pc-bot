# ---------------------------------------------------------------- config

def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


CONFIG_LOCK = threading.Lock()


def save_config(cfg):
    """Several threads save (the chat thread, the poller); one at a time, from
    a snapshot, through a temp file of our own, so a save can't be torn."""
    with CONFIG_LOCK:
        data = json.dumps(cfg, indent=2)
        os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".config-", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, CONFIG)
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise


# ---------------------------------------------------------------- telegram

class TelegramError(RuntimeError):
    pass


class Telegram:
    """The Bot API over plain HTTPS. Errors come back as TelegramError with
    Telegram's own description ("Bad Request: message is not modified")."""

    def __init__(self, token):
        self.token = token

    def call(self, method, params=None, timeout=20):
        url = API.format(token=self.token, method=method)
        req = urllib.request.Request(url, data=json.dumps(params or {}).encode(),
                                     headers={"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                body = json.loads(r.read(64_000_000))
        except urllib.error.HTTPError as e:
            try:
                body = json.loads(e.read(100_000))
            except ValueError:
                raise TelegramError(f"HTTP {e.code}") from None
        if not body.get("ok"):
            raise TelegramError(body.get("description", "Telegram said no"))
        return body["result"]

    def send_text(self, chat_id, text, buttons=None, silent=False):
        params = {"chat_id": chat_id, "text": text[:4096], "link_preview_options": {"is_disabled": True}}
        if buttons:
            params["reply_markup"] = keyboard(buttons)
        if silent:
            params["disable_notification"] = True
        return self.call("sendMessage", params)

    def send(self, chat_id, markdown, plain_entities=False, buttons=None, silent=False):
        """A rich message from Markdown (headings, tables, code...), with
        optional buttons. Falls back to plain text if Telegram can't take it."""
        rich = {"markdown": markdown[:32000]}
        if plain_entities:
            rich["skip_entity_detection"] = True
        params = {"chat_id": chat_id, "rich_message": rich}
        if buttons:
            params["reply_markup"] = keyboard(buttons)
        if silent:
            params["disable_notification"] = True
        try:
            return self.call("sendRichMessage", params)
        except TelegramError as e:
            log("rich message refused, sending plain:", e)
            return self.send_text(chat_id, plain(markdown), buttons, silent)

    def edit(self, chat_id, message_id, markdown, buttons=None):
        params = {"chat_id": chat_id, "message_id": message_id, "rich_message": {"markdown": markdown[:32000]}}
        if buttons is not None:
            params["reply_markup"] = keyboard(buttons)
        try:
            return self.call("editMessageText", params)
        except TelegramError as e:
            if "not modified" not in str(e):
                raise

    def delete(self, chat_id, message_id):
        try:
            self.call("deleteMessage", {"chat_id": chat_id, "message_id": message_id}, timeout=10)
        except Exception as e:
            log("delete failed:", e)

    def answer_callback(self, query_id, text=""):
        try:
            self.call("answerCallbackQuery", {"callback_query_id": query_id, "text": text[:200]}, timeout=10)
        except Exception:
            pass

    def draft(self, chat_id, draft_id, markdown, can_stop=True):
        """Stream a reply while it's written: a 30-second live preview, with a
        stop button. sendRichMessage afterwards makes it permanent."""
        return self.call("sendRichMessageDraft", {"chat_id": chat_id, "draft_id": draft_id,
                                                  "rich_message": {"markdown": markdown[:32000]},
                                                  "can_stop": can_stop}, timeout=10)

    def typing(self, chat_id):
        try:
            self.call("sendChatAction", {"chat_id": chat_id, "action": "typing"}, timeout=10)
        except Exception:
            pass

    def widget(self, chat_id, html, chat_data="", allow_queries=False, height=None):
        params = {"chat_id": chat_id, "html": html}
        if chat_data:
            params["chat_data"] = chat_data
        if allow_queries:
            params["allow_queries"] = True
        if height:
            params["height"] = height
        return self.call("sendWidget", params)

    def answer_widget(self, query_id, data):
        return self.call("answerWidgetQuery", {"widget_query_id": query_id, "data": data[:1024]}, timeout=10)

    def download(self, file_id, limit=20_000_000):
        info = self.call("getFile", {"file_id": file_id})
        if int(info.get("file_size") or 0) > limit:
            raise TelegramError("That file is too big.")
        url = f"https://api.telegram.org/file/bot{self.token}/{info['file_path']}"
        with urllib.request.urlopen(url, timeout=60) as r:
            return r.read(limit + 1)[:limit]

    def upload(self, method, field, filename, content_type, data, fields):
        boundary = uuid.uuid4().hex
        parts = []
        for name, value in fields.items():
            if value in (None, ""):
                continue
            value = json.dumps(value) if isinstance(value, (dict, list)) else str(value)
            parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode())
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{field}"; filename="{filename}"\r\n'
                     f'Content-Type: {content_type}\r\n\r\n'.encode() + data + b"\r\n")
        parts.append(f"--{boundary}--\r\n".encode())
        url = API.format(token=self.token, method=method)
        req = urllib.request.Request(url, data=b"".join(parts),
                                     headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                body = json.loads(r.read(200_000))
        except urllib.error.HTTPError as e:
            body = json.loads(e.read(100_000) or b"{}")
        if not body.get("ok"):
            raise TelegramError(body.get("description", "upload failed"))
        return body["result"]

    def send_photo(self, chat_id, path, caption="", buttons=None):
        with open(path, "rb") as f:
            image = f.read()
        return self.upload("sendPhoto", "photo", "screen.png", "image/png", image,
                           {"chat_id": chat_id, "caption": caption[:1000],
                            "reply_markup": keyboard(buttons) if buttons else None})

    def send_document(self, chat_id, filename, data, caption=""):
        return self.upload("sendDocument", "document", filename, "text/plain", data,
                           {"chat_id": chat_id, "caption": caption[:1000]})

    def set_commands(self, commands):
        self.call("setMyCommands", {"commands": [{"command": c, "description": d} for c, d in commands]})


def keyboard(rows):
    """[[("Label", "callback-data"), ...], ...] -> an inline keyboard."""
    return {"inline_keyboard": [[{"text": t, "callback_data": d} for t, d in row] for row in rows]}


class RootHelper:
    """Talks to /usr/local/lib/pc-bot/pc-bot-root through sudo. The helper,
    not this bot, holds the authenticator secret and checks every code."""

    def __init__(self):
        self.checked_at, self.ok = 0.0, False

    def available(self):
        if time.time() - self.checked_at > 60:
            self.checked_at = time.time()
            self.ok = os.path.exists(ROOT) and self.call({"action": "status"}).get("ok") is True
        return self.ok

    def call(self, request, timeout=30):
        try:
            out = subprocess.run([SUDO, "-n", ROOT], input=json.dumps(request), capture_output=True,
                                 text=True, timeout=timeout)
            return json.loads(out.stdout or "{}") or {"ok": False, "error": "No answer from the root helper."}
        except subprocess.TimeoutExpired:
            return {"ok": False, "error": "The root helper took too long."}
        except (OSError, ValueError) as e:
            return {"ok": False, "error": f"The root helper failed: {e}"}


