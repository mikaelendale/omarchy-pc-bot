def cmd_setup(_args):
    print("Connect pc-bot to Telegram\n")
    print("1. In Telegram, open @BotFather and send /newbot.")
    print("2. Pick a name, then a username ending in 'bot'. BotFather replies with a token.\n")
    token = getpass.getpass("Paste the token here (it stays hidden): ").strip()
    if not re.fullmatch(r"\d+:[\w-]{30,}", token):
        print("That doesn't look like a bot token (it should look like 123456:ABC-...).")
        return 1
    tg = Telegram(token)
    try:
        me = tg.call("getMe")
    except Exception as e:
        print(f"Telegram didn't accept that token: {e}")
        return 1
    print(f"\nFound your bot: @{me['username']}")
    print(f"3. Open https://t.me/{me['username']} and press Start (or send it any message).")
    print("   Waiting up to 3 minutes...")
    offset, chat, deadline = None, None, time.time() + 180
    while time.time() < deadline and chat is None:
        params = {"timeout": 25}
        if offset is not None:
            params["offset"] = offset
        try:
            updates = tg.call("getUpdates", params, timeout=35)
        except Exception as e:
            print(f"   (network hiccup: {e})")
            time.sleep(3)
            continue
        for u in updates:
            offset = u["update_id"] + 1
            msg = u.get("message") or {}
            if (msg.get("chat") or {}).get("type") == "private":
                chat = msg["chat"]["id"]
                who = msg.get("from", {}).get("first_name", "you")
    if chat is None:
        print("No message arrived. Run pc-bot setup again when you're ready.")
        return 1
    try:
        tg.call("getUpdates", {"offset": offset, "timeout": 0})   # don't replay /start later
    except Exception:
        pass
    cfg = load_config()
    cfg.update({"token": token, "chat_id": chat, "mode": cfg.get("mode", "away")})
    save_config(cfg)
    tg.send(chat, f"**Connected to your PC.**\n\n" + Bot.HELP)
    print(f"\nConnected to {who}'s chat. Saved to {CONFIG} (only you can read it).")
    out = subprocess.run(["systemctl", "--user", "enable", "--now", "pc-bot"], capture_output=True, text=True)
    if out.returncode == 0:
        subprocess.run(["systemctl", "--user", "restart", "pc-bot"])
        print("The service is running and starts with your desktop. Check Telegram!")
    else:
        print("Start it with: systemctl --user enable --now pc-bot")
    return 0


