    # ---- commands

    def handle(self, text):
        cmd, _, arg = text.strip().partition(" ")
        cmd = cmd.split("@")[0].lower()
        arg = arg.strip()
        if cmd in ("/start", "/menu"):
            self.send_menu()
            return None
        if cmd == "/help":
            return self.HELP
        if cmd == "/style":
            return self.inbox.style_cmd(arg)
        if cmd == "/inbox":
            self.tg.send(self.chat, self.inbox.status_text(), buttons=self.inbox.status_buttons())
            return None
        if cmd == "/catchup":
            return self.inbox.catchup_cmd(arg)
        if cmd == "/status":
            self.send_status()
            return None
        if cmd == "/lock":
            run(["omarchy-shell", "-q", "lock", "lock"])
            return "**Screen locked.**"
        if cmd == "/lockdown":
            self.do_lockdown("from Telegram")
            return self.LOCKED_DOWN
        if cmd in ("/away", "/all", "/quiet") or cmd == "/mode":
            mode = cmd[1:] if cmd != "/mode" else arg.lower()
            if mode not in MODES:
                return f"Sending *{self.mode}* events. Choose /away, /all or /quiet."
            self.cfg["mode"] = mode
            save_config(self.cfg)
            return {"away": "**Away mode.** Everyday events only while you're away; important ones always.",
                    "all": "**All events,** always.",
                    "quiet": "**Quiet.** Important events only."}[mode]
        if self.lockdown:
            return self.LOCKED_DOWN
        if cmd == "/logout":
            self.trusted_until = 0.0
            self.trust_gen += 1
            return "**Bot locked.** Your code unlocks it again."
        if cmd == "/stop":
            if not self.claude.busy:
                return "*Claude isn't doing anything right now.*"
            self.claude.stop()
            return None
        if cmd == "/look":
            self.claude.state["access"] = "look"
            save_config(self.cfg)
            return "**Look mode.** Claude can read files and search the web, but can't change anything."
        if cmd == "/session":
            if not arg:
                return (f"The bot stays unlocked for **{self.unlock_minutes} minutes** after you last use it "
                        f"(12 hours at most). Change it with `/session 90` ({UNLOCK_RANGE[0]} to {UNLOCK_RANGE[1]} minutes).")
            try:
                minutes = int(arg.split()[0])
            except ValueError:
                return f"Usage: `/session 60` (minutes, {UNLOCK_RANGE[0]} to {UNLOCK_RANGE[1]})"

            def change():
                m = max(UNLOCK_RANGE[0], min(UNLOCK_RANGE[1], minutes))
                self.cfg.setdefault("security", {})["unlock_minutes"] = m
                save_config(self.cfg)
                if self.trusted():
                    self.trusted_until = clock() + m * 60
                return f"**Unlock time: {m} minutes** after you last use the bot."
            return self.gated(change, "change how long the bot stays unlocked")
        if cmd == "/sudo":
            if not arg:
                return "Usage: `/sudo systemctl restart bluetooth`"
            if not self.security_on():
                return f"*Root isn't set up yet.* At the PC, run:\n```bash\n{SETUP_CMD}\n```"
            if not self.root.available():
                return "*The root helper isn't answering.* At the PC: `sudo /usr/local/lib/pc-bot/pc-bot-root-admin status`"
            self.ask_code("sudo", command=arg[:4000])
            return None
        if cmd == "/apps":
            return self.gated(self.apps_text, "see your windows")
        if cmd == "/screen":
            return self.gated(self.send_screen, "see your screen")
        if cmd == "/say":
            if not arg:
                return "Usage: `/say Dinner's ready`"
            return self.gated(lambda: self.say(arg), "show a message on the PC")
        if cmd == "/new":
            self.claude.new()
            return "**Fresh conversation.** What's up?"
        if cmd == "/work":
            def work():
                # Fresh conversation: text Claude read in look mode (web pages,
                # files) mustn't carry over into a session that can run commands.
                self.claude.new()
                self.claude.state["access"] = "work"
                save_config(self.cfg)
                return ("**Work mode,** in a fresh conversation. Claude can run commands and edit files on your PC; "
                        "its safety check still blocks risky actions. /look to go back.")
            return self.gated(work, "let Claude run commands")
        if cmd == "/claude" and arg:
            return self.to_claude([{"type": "text", "text": arg}])
        if not cmd.startswith("/"):
            return self.to_claude([{"type": "text", "text": text.strip()}])
        return "*I don't know that one.* /help lists what I can do."

    def apps_text(self):
        wins = sorted(windows(), key=lambda w: (w.get("workspace", {}).get("id", 0), w.get("class", "")))
        if not wins:
            return "*No windows open.*"
        rows = "\n".join(f"| {md(w.get('workspace', {}).get('name', '?'))} | {md(w.get('class', '?').split('.')[-1])} | "
                         f"{md(shorten(w.get('title', ''), 50))} |" for w in wins[:40])
        return f"| Space | App | Window |\n|---|---|---|\n{rows}"

    def send_screen(self):
        path = os.path.join(RUNTIME, f"screen-{int(time.time())}.png")
        os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
        run(["grim", path], timeout=10)
        if not os.path.exists(path):
            return "*Couldn't take a screenshot.*"
        try:
            self.tg.send_photo(self.chat, path, "Locked" if self.locked else "",
                               buttons=[[("Again", "m:screen"), ("Lock screen", "m:lock"), ("Lockdown", "m:lockdown")]])
        finally:
            os.unlink(path)
        return None

    def say(self, text):
        run(["notify-send", "-a", "pc-bot", "--", "From your phone", text[:500]])
        return "*Shown on the screen.*"

    def to_claude(self, content, header=""):
        def go():
            if self.claude.busy:
                return "*Claude is still on your last message.* /stop cancels it."
            self.claude.ask(content, header)
            return None
        return self.gated(go, "talk to Claude")

    def on_voice(self, voice):
        """A voice note: transcribe it with Superwhisper, then ask Claude."""
        def go():
            if self.claude.busy:
                return "*Claude is still on your last message.* /stop cancels it."
            self.tg.typing(self.chat)
            os.makedirs(RUNTIME, mode=0o700, exist_ok=True)
            path = os.path.join(RUNTIME, f"voice-{int(time.time() * 1000)}.ogg")
            try:
                with open(path, "wb") as f:
                    f.write(self.tg.download(voice["file_id"]))
                text = transcribe(path)
            except Exception as e:
                return f"**Voice note:** {md(e)}"
            finally:
                if os.path.exists(path):
                    os.unlink(path)
            self.claude.ask([{"type": "text", "text": text}], f"> {md(shorten(text, 400))}")
            return None
        return self.gated(go, "talk to Claude")

    def on_photo(self, photos, caption):
        """A photo (with or without a caption): Claude looks at it."""
        def go():
            if self.claude.busy:
                return "*Claude is still on your last message.* /stop cancels it."
            fitting = [p for p in photos if max(p.get("width", 0), p.get("height", 0)) <= 2560] or photos[:1]
            try:
                data = self.tg.download(fitting[-1]["file_id"], limit=10_000_000)
            except Exception as e:
                return f"*Couldn't get the photo:* {md(e)}"
            image = {"type": "image", "source": {"type": "base64", "media_type": "image/jpeg",
                                                 "data": base64.b64encode(data).decode()}}
            self.claude.ask([image, {"type": "text", "text": caption.strip() or "What is this?"}])
            return None
        return self.gated(go, "show Claude a photo")

    def poll(self):
        offset, conflicts = None, 0
        while not self.stopping.is_set():
            try:
                params = {"timeout": 50, "limit": 20, "allowed_updates": ["message", "callback_query",
                                                             "stopped_message_generation", "widget_query"]
                                                            + BUSINESS_UPDATES}
                if offset is not None:
                    params["offset"] = offset
                updates = self.tg.call("getUpdates", params, timeout=65)
                conflicts = 0
            except Exception as e:
                log("poll failed:", e)
                if "Conflict" in str(e):
                    # Twice in a row rules out a restart overlapping with itself.
                    conflicts += 1
                    if conflicts >= 2:
                        why = ("a webhook was set on your bot, so Telegram sends its messages elsewhere"
                               if "webhook" in str(e) else "another program is reading your bot's messages with its token")
                        self.event(f"**Warning:** {why}. If that isn't you, revoke the token in @BotFather "
                                   "(/revoke), then run `pc-bot setup` again. Until then don't send codes.",
                                   important=True, kind="conflict", every=1800)
                    self.stopping.wait(3)
                    continue
                self.stopping.wait(10)
                continue
            for u in updates:
                offset = u["update_id"] + 1
                try:
                    self.on_update(u)
                except Exception as e:
                    log("update failed:", repr(e))

    def on_update(self, u):
        if "stopped_message_generation" in u:
            stop = u["stopped_message_generation"]
            if (stop.get("chat") or {}).get("id") == self.chat and stop.get("draft_id") == self.claude.draft_id:
                self.claude.stop()
            return
        if "widget_query" in u:
            self.answer_widget_query(u["widget_query"])
            return
        if "callback_query" in u:
            self.on_callback(u["callback_query"])
            return
        # Your own Telegram account (Telegram Business): see Inbox.
        if "business_connection" in u:
            self.inbox.on_connection(u["business_connection"])
            return
        if "business_message" in u or "edited_business_message" in u:
            self.inbox.on_message(u.get("business_message") or u["edited_business_message"],
                                  edited="edited_business_message" in u)
            return
        if "deleted_business_messages" in u:
            self.inbox.on_deleted(u["deleted_business_messages"])
            return
        msg = u.get("message") or {}
        if not msg:
            return
        chat_obj = msg.get("chat") or {}
        chat = chat_obj.get("id")
        who = msg.get("from") or {}
        if chat_obj.get("type") != "private":
            # Anyone can add a bot to a group; it has no business there.
            try:
                self.tg.call("leaveChat", {"chat_id": chat})
            except Exception:
                pass
            self.event(f"**Someone added the bot to a group** ({md(chat_obj.get('title', '?'))}). It left.",
                       important=True, kind=f"group-{chat}", every=3600)
            return
        if chat != self.chat or who.get("id") != self.chat:
            key = who.get("id")
            if key not in self.strangers and len(self.strangers) < 1000:
                self.strangers.add(key)
                name = who.get("username") or who.get("first_name") or "someone"
                self.event(f"**Someone else messaged the bot:** {md(name)} (id {key}). Ignored.", important=True)
            return
        text = msg.get("text") or ""
        log("command:", shorten(text, 60) if not CODE.match(text) else "(code)",
            "voice" if msg.get("voice") else "photo" if msg.get("photo") else "")

        # A 6-digit code answers whatever is waiting for one; the message is
        # deleted so the code doesn't sit in the chat.
        m = CODE.match(text)
        if m and not self.pending:
            # Never let a stray code reach Claude: in work mode Claude runs as
            # you and could hand it to the root helper itself.
            self.tg.delete(self.chat, msg["message_id"])
            self.tg.send(self.chat, "*No request was waiting for a code,* so I deleted it. "
                                    "Send the code right after a prompt.")
            return
        if m and self.pending:
            self.tg.delete(self.chat, msg["message_id"])
            if clock() - self.pending["at"] > 120:
                self.pending = None
                self.tg.send(self.chat, "*That request expired.* Ask again.")
                return
            if self.lockdown:
                self.pending = None
                self.tg.send(self.chat, self.LOCKED_DOWN)
                return
            self.use_code(m.group(1) + m.group(2))
            return

        # A reply to an inbox card says what to answer that person.
        card = self.inbox.card_for((msg.get("reply_to_message") or {}).get("message_id"))
        if card:
            reply = self.inbox.on_instruction(card, text, msg.get("voice") or msg.get("audio"))
            if reply:
                self.tg.send(self.chat, reply)
            return

        if msg.get("voice") or msg.get("audio"):
            reply = self.on_voice(msg.get("voice") or msg.get("audio"))
        elif msg.get("photo"):
            reply = self.on_photo(msg["photo"], msg.get("caption") or "")
        elif text.strip():
            reply = self.handle(text)
        else:
            reply = "*I can read text, voice notes and photos.*"
        if reply:
            self.tg.send(self.chat, reply)

    def serve(self):
        try:
            uptime = float(read("/proc/uptime", "0").split()[0])
        except ValueError:
            uptime = 9999
        if uptime < 600:
            self.event("**PC turned on**", important=True)

        def on_term(*_):
            self.claude.stop()
            if run(["systemctl", "is-system-running"]) == "stopping":
                try:
                    self.tg.send(self.chat, "**Shutting down**")
                except Exception:
                    pass
            self.stopping.set()
            sys.exit(0)

        signal.signal(signal.SIGTERM, on_term)
        try:
            self.tg.set_commands(self.COMMANDS)
            self.tg.call("setMyShortDescription", {"short_description": "Your PC, on Telegram: events, Claude, and root with a code."})
        except Exception as e:
            log("couldn't set the command list:", e)
        workers = [self.sender, self.poll, self.watch_presence, self.watch_power, self.watch_journal,
                   self.watch_network, self.watch_downloads, self.watch_camera, self.watch_disk, self.watch_socket,
                   self.inbox.worker, self.inbox.daily]
        for w in workers:
            threading.Thread(target=self.guard, args=(w,), daemon=True, name=w.__name__).start()
        log(f"running, mode {self.mode}")
        while not self.stopping.wait(3600):
            pass

    def guard(self, worker):
        """Restart a watcher that dies, with a pause, so one broken source never
        takes the rest down."""
        while not self.stopping.is_set():
            try:
                worker()
            except Exception as e:
                log(f"{worker.__name__} stopped:", repr(e))
            if self.stopping.wait(30):
                return


