#!/usr/bin/env python3
"""pc-bot-account: read-only access to your own Telegram account, for pc-bot.

pc-bot answers your chats through Telegram Business, which only shows a bot
new messages. This helper signs in as you (Telethon, the MTProto client API) so
drafts and /catchup can see each chat's history. It can only read, and only the
chats your Chat Automation settings give the bot:

  - no sending, editing, deleting, reading receipts or anything else: the only
    requests it makes are the ones below
  - only private chats with people the bot is allowed to manage (Settings,
    Telegram Business, Chatbots), re-checked every minute
  - only while signed in as the same account that owns the bot

    pc-bot-account login  --config FILE --owner ID     sign in (interactive)
    pc-bot-account serve  --config FILE --owner ID --bot ID
    pc-bot-account logout --config FILE

`serve` answers one JSON request per line on stdin with one JSON line on stdout:
  {"op": "status"}                      who you are, which chats are allowed
  {"op": "dialogs", "limit": 200}       allowed private chats: unread count, last message
  {"op": "history", "peer": ID, "limit": 60}   one allowed chat, oldest first

It runs in its own virtualenv with Telethon; pc-bot starts it. The sign-in
lives next to the config (account.session, readable only by you). Anyone who
gets that file can use your Telegram account: `pc-bot account off` signs it
out everywhere and deletes it.
"""

import argparse
import getpass
import json
import os
import sys
import time

os.umask(0o077)

try:
    from telethon.errors import FloodWaitError, SessionPasswordNeededError
    from telethon.sync import TelegramClient
    from telethon.tl import functions, types
except ImportError:
    print(json.dumps({"ok": False, "error": "Telethon isn't installed (run pc-bot account)"}), flush=True)
    sys.exit(3)


def load(path):
    with open(path) as f:
        return json.load(f)


def client_for(cfg_path):
    cfg = load(cfg_path)
    session = os.path.join(os.path.dirname(cfg_path), "account")
    return TelegramClient(session, int(cfg["api_id"]), cfg["api_hash"], receive_updates=False,
                          device_model="pc-bot (read-only)", app_version="pc-bot")


def tighten(cfg_path):
    for name in ("account.session", "account.session-journal"):
        p = os.path.join(os.path.dirname(cfg_path), name)
        if os.path.exists(p):
            os.chmod(p, 0o600)


# ---------------------------------------------------------------- what a message says

def describe(m, by_id=None):
    tag = ""
    media = m.media
    if m.voice:
        tag = "[voice note]"
    elif m.video_note:
        tag = "[video message]"
    elif m.sticker:
        emoji = getattr(m.file, "emoji", "") or ""
        tag = f"[sticker {emoji}]".replace(" ]", "]")
    elif m.gif:
        tag = "[GIF]"
    elif m.photo:
        tag = "[photo]"
    elif m.video:
        tag = "[video]"
    elif m.audio:
        tag = "[audio]"
    elif m.document:
        tag = f"[file {getattr(m.file, 'name', '') or ''}]".replace(" ]", "]")
    elif isinstance(media, types.MessageMediaGeo):
        tag = "[location]"
    elif isinstance(media, types.MessageMediaContact):
        tag = "[contact]"
    elif isinstance(media, types.MessageMediaPoll):
        tag = f"[poll: {media.poll.question.text if hasattr(media.poll.question, 'text') else media.poll.question}]"
    if m.fwd_from:
        tag = ("[forwarded] " + tag).strip()
    out = " ".join(x for x in (tag, m.message or "") if x)
    reply = getattr(m.reply_to, "reply_to_msg_id", None)
    if reply and by_id and reply in by_id:
        snippet = " ".join(describe(by_id[reply]).split())[:80]
        out = f'(replying to "{snippet}") ' + out
    return out or "[message]"


def name_of(user):
    name = " ".join(x for x in (getattr(user, "first_name", None), getattr(user, "last_name", None)) if x)
    return (name or getattr(user, "username", None) or "Someone")[:40]


# ---------------------------------------------------------------- which chats the bot may manage

class Allowed:
    """Mirrors Settings, Telegram Business, Chatbots for this bot."""

    def __init__(self, client, bot_id):
        self.client, self.bot_id = client, bot_id
        self.rules, self.since, self.at = None, None, 0.0
        self.existed = {}

    def refresh(self, force=False):
        if not force and time.time() - self.at < 60:
            return
        r = self.client(functions.account.GetConnectedBotsRequest())
        bot = next((b for b in r.connected_bots if b.bot_id == self.bot_id), None)
        self.rules = bot.recipients if bot else None
        self.since = bot.date if bot else None
        self.at = time.time()

    def has_chat_before(self, uid):
        """Did this chat exist before the bot was connected? (for the 'existing
        chats' / 'new chats' categories)"""
        if uid not in self.existed:
            if not self.since:
                return False
            older = self.client.get_messages(uid, limit=1, offset_date=self.since)
            self.existed[uid] = bool(older)
        return self.existed[uid]

    def ok(self, user):
        """Same rules as Telegram: excluded users first, then the explicit list
        and categories; 'All private chats except' turns the match around.
        Anything unclear counts as not allowed."""
        self.refresh()
        r = self.rules
        if r is None or not isinstance(user, types.User) or user.bot or user.is_self or user.deleted:
            return False
        uid = user.id
        if uid in (r.exclude_users or []):
            return False
        match = uid in (r.users or [])
        if not match and (r.contacts or r.non_contacts):
            match = (r.contacts and user.contact) or (r.non_contacts and not user.contact)
        if not match and (r.existing_chats or r.new_chats):
            before = self.has_chat_before(uid)
            match = (r.existing_chats and before) or (r.new_chats and not before)
        return (not match) if r.exclude_selected else bool(match)


# ---------------------------------------------------------------- serve

def serve(args):
    try:
        client = client_for(args.config)
        client.connect()
    except Exception as e:
        print(json.dumps({"ok": False, "fatal": True, "error": f"Couldn't reach Telegram ({type(e).__name__})"}),
              flush=True)
        return 2
    tighten(args.config)
    if not client.is_user_authorized():
        print(json.dumps({"ok": False, "fatal": True, "error": "Not signed in (run pc-bot account)"}), flush=True)
        return 2
    me = client.get_me()
    if me.id != args.owner:
        print(json.dumps({"ok": False, "fatal": True,
                          "error": "Signed in as a different account than the one that owns the bot"}), flush=True)
        return 2
    allowed = Allowed(client, args.bot)
    users = {}                  # id -> User, from the dialog list (Telethon needs them to address a chat)

    def dialogs(limit):
        out = []
        for d in client.iter_dialogs(limit=limit):
            u = d.entity
            if not isinstance(u, types.User):
                continue
            users[u.id] = u
            if not allowed.ok(u):
                continue
            last = d.message
            out.append({"peer": u.id, "name": name_of(u), "unread": d.unread_count,
                        "last": {"id": last.id, "t": int(last.date.timestamp()), "me": bool(last.out),
                                 "text": describe(last)} if last else None})
        return out

    def history(peer, limit):
        if peer not in users:
            dialogs(500)
        u = users.get(peer)
        if u is None or not allowed.ok(u):
            return None
        msgs = client.get_messages(u, limit=max(1, min(int(limit), 200)))
        by_id = {m.id: m for m in msgs}
        out = []
        for m in reversed(msgs):
            if isinstance(m, types.MessageService):
                continue
            e = {"id": m.id, "t": int(m.date.timestamp()), "me": bool(m.out), "text": describe(m, by_id)}
            if not m.out:
                e["n"] = name_of(u)
            out.append(e)
        return out

    allowed.refresh(force=True)
    dialogs(500)
    print(json.dumps({"ok": True, "ready": True, "me": me.id}), flush=True)
    for line in sys.stdin:
        try:
            req = json.loads(line)
            op = req.get("op")
            if op == "status":
                allowed.refresh(force=True)
                res = {"ok": True, "me": name_of(me), "connected": allowed.rules is not None,
                       "allowed": [d["peer"] for d in dialogs(500)]}
            elif op == "dialogs":
                res = {"ok": True, "dialogs": dialogs(int(req.get("limit") or 200))}
            elif op == "history":
                msgs = history(int(req["peer"]), req.get("limit") or 60)
                res = {"ok": True, "messages": msgs} if msgs is not None else \
                      {"ok": False, "error": "That chat isn't one the bot may manage"}
            else:
                res = {"ok": False, "error": "unknown request"}
        except FloodWaitError as e:
            res = {"ok": False, "error": f"Telegram asks to wait {e.seconds} s"}
        except Exception as e:
            res = {"ok": False, "error": f"{type(e).__name__}: {e}"[:300]}
        print(json.dumps(res, ensure_ascii=False), flush=True)
    client.disconnect()
    return 0


# ---------------------------------------------------------------- login / logout

def login(args):
    client = client_for(args.config)
    client.connect()
    tighten(args.config)
    if not client.is_user_authorized():
        phone = input("Your phone number, with country code (+251...): ").strip()
        client.send_code_request(phone)
        code = input("The login code Telegram just sent you (in the Telegram app): ").strip()
        try:
            client.sign_in(phone, code)
        except SessionPasswordNeededError:
            client.sign_in(password=getpass.getpass("Your Two-Step Verification password (hidden): "))
    me = client.get_me()
    tighten(args.config)
    if me.id != args.owner:
        print(f"\nThat's {name_of(me)}, not the account that owns the bot. Signing it out again.")
        client.log_out()
        return 1
    print(f"\nSigned in as {name_of(me)} (read-only use).")
    client.disconnect()
    return 0


def logout(args):
    client = client_for(args.config)
    client.connect()
    if client.is_user_authorized():
        client.log_out()          # ends the session on Telegram's side too
        print("Signed out on Telegram.")
    client.disconnect()
    for name in ("account.session", "account.session-journal"):
        p = os.path.join(os.path.dirname(args.config), name)
        if os.path.exists(p):
            os.unlink(p)
    return 0


def main():
    p = argparse.ArgumentParser(description="Read-only Telegram account access for pc-bot")
    p.add_argument("command", choices=["serve", "login", "logout"])
    p.add_argument("--config", required=True)
    p.add_argument("--owner", type=int, default=0)
    p.add_argument("--bot", type=int, default=0)
    args = p.parse_args()
    return {"serve": serve, "login": login, "logout": logout}[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
